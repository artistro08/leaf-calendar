<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
        <TargetPlatformMinVersion>10.0.22000.0</TargetPlatformMinVersion>
        <RootNamespace>LeafCalendar.Core</RootNamespace>
        <IsAotCompatible>true</IsAotCompatible>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Data.Sqlite" />
        <PackageReference Include="Meziantou.Framework.Scheduling" />
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="LeafCalendar.Tests" />
    </ItemGroup>

    <!-- Leaf Calendar's icon on the browser sign-in page (LoopbackListener) -->
    <ItemGroup>
        <EmbeddedResource Include="..\LeafCalendar.App\Assets\Square44x44Logo.targetsize-64_altform-unplated.png" LogicalName="LeafCalendar.Core.Auth.SignInIcon.png" Link="Auth\SignInIcon.png" />
        <!-- Cities and their time zones, from GeoNames (tools/build-cities.ps1) -->
        <EmbeddedResource Include="Views\Cities.tsv.gz" LogicalName="LeafCalendar.Core.Views.Cities.tsv.gz" />
    </ItemGroup>
</Project>
