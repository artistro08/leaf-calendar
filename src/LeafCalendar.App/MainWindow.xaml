<Window
    x:Class="LeafCalendar.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:LeafCalendar.App.Controls"
    Title="Leaf Calendar">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Content (the calendar runs under the title bar, so it spans the title bar row) -->
        <Frame x:Name="ContentFrame" Grid.RowSpan="2" Navigated="OnNavigated" />

        <!-- Settings (in place of the calendar, under the title bar, while it's open: MainWindow.ShowSettings; the view drills
             in, and the title bar's back button returns to the calendar) -->
        <Frame x:Name="SettingsFrame" Grid.Row="1" Visibility="Collapsed" IsNavigationStackEnabled="False" />

        <!-- Title Bar -->
        <TitleBar
            x:Name="AppTitleBar"
            IsBackButtonVisible="False"
            IsPaneToggleButtonVisible="False"
            PaneToggleRequested="OnPaneToggleRequested"
            BackRequested="OnBackRequested"
            AutomationProperties.AutomationId="AppTitleBar">
            <TitleBar.Resources>
                <x:Double x:Key="TitleBarCompactHeight">48</x:Double>
                <x:Double x:Key="TitleBarMinDragRegionWidth">8</x:Double>
                <HorizontalAlignment x:Key="TitleBarContentHorizontalAlignment">Stretch</HorizontalAlignment>
                <StaticResource x:Key="TitleBarPaneToggleButtonStyle" ResourceKey="LeafTitleBarPaneToggleButtonStyle" />
            </TitleBar.Resources>

            <!-- App Icon (no title) -->
            <TitleBar.IconSource>
                <ImageIconSource>
                    <ImageIconSource.ImageSource>
                        <!-- Decoded at its size on screen (16 DIP at this scale), so it isn't shrunk with jagged edges -->
                        <BitmapImage UriSource="ms-appx:///Assets/AppLogo.png" DecodePixelWidth="16" DecodePixelHeight="16" DecodePixelType="Logical" />
                    </ImageIconSource.ImageSource>
                </ImageIconSource>
            </TitleBar.IconSource>

            <!-- Toolbar (only its buttons take clicks; the space around them drags the window) -->
            <TitleBar.Content>
                <Grid x:Name="ToolbarHost">
                    <!-- Sidebar Actions: Create event, then Search (opens the command menu), at the right end of the sidebar's
                         title bar row with Search centered over the mini month's Next month button; after the title bar's left
                         items when the sidebar is closed. Placed in code -->
                    <StackPanel x:Name="SidebarActions" HorizontalAlignment="Left" Orientation="Horizontal" Spacing="4">
                        <!-- Create Event (a new event at the picked time or the next quarter hour, like C). Segoe Fluent Icons
                             has no calendar-add glyph: a calendar on the 16 DIP grid with a plus in its corner, 1 px strokes -->
                        <Button
                            x:Name="CreateEventButton"
                            Style="{StaticResource LeafBareIconButtonStyle}"
                            Click="OnCreateEventClick"
                            ToolTipService.ToolTip="Create event (C)"
                            AutomationProperties.Name="Create event"
                            AutomationProperties.AutomationId="CreateEventButton">
                            <PathIcon
                                Width="16"
                                Height="16"
                                Data="F1 M3,2 H13 A2,2 0 0 1 15,4 V8 H14 V4 A1,1 0 0 0 13,3 H3 A1,1 0 0 0 2,4 V12 A1,1 0 0 0 3,13 H8 V14 H3 A2,2 0 0 1 1,12 V4 A2,2 0 0 1 3,2 Z M2,5 H14 V6 H2 Z M10,12 H15 V13 H10 Z M12,10 H13 V15 H12 Z" />
                        </Button>
                        <!-- /Create Event -->

                        <!-- Search -->
                        <Button
                            x:Name="SearchButton"
                            Style="{StaticResource LeafBareIconButtonStyle}"
                            Click="OnSearchClick"
                            ToolTipService.ToolTip="Search (Ctrl+K)"
                            AutomationProperties.Name="Search"
                            AutomationProperties.AutomationId="SearchButton">
                            <FontIcon Glyph="&#xE721;" FontSize="16" />
                        </Button>
                    </StackPanel>
                    <!-- /Sidebar Actions -->

                    <!-- Slide (the toolbar and the edit icon follow the island's right edge together) -->
                    <Grid x:Name="ToolbarSlide">
                        <StackPanel
                            x:Name="CalendarToolbar"
                            HorizontalAlignment="Right"
                            Orientation="Horizontal"
                            Spacing="4"
                            Visibility="Collapsed">
                            <!-- Sync Status (one 32 DIP slot, shown only when something needs attention, one state at a time: conflicts, then
                                 offline, then changes waiting. Syncing itself stays in the background: offline and waiting show only once 3 syncs
                                 in a row couldn't reach Google. Offline with changes waiting, the waiting button takes the offline glyph and sits
                                 exactly over the offline one, so both can be read at once) -->
                            <Grid x:Name="SyncStatus" Width="32" Height="32" Visibility="Collapsed">
                                <Button
                                    x:Name="ConflictsButton"
                                    Style="{StaticResource LeafBareIconButtonStyle}"
                                    Visibility="Collapsed"
                                    Click="OnConflictsClick"
                                    AutomationProperties.LiveSetting="Polite"
                                    AutomationProperties.AutomationId="ConflictsButton">
                                    <Grid>
                                        <FontIcon Glyph="&#xE7BA;" FontSize="16" />
                                        <!-- The negative margin lets the badge overlap the top-right corner of its 32 DIP icon button -->
                                        <InfoBadge
                                            x:Name="ConflictsBadge"
                                            Margin="0,-6,-8,0"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Top"
                                            AutomationProperties.AccessibilityView="Raw" />
                                    </Grid>
                                </Button>
                                <Button
                                    x:Name="OfflineButton"
                                    Style="{StaticResource LeafBareIconButtonStyle}"
                                    Visibility="Collapsed"
                                    Click="OnSyncStatusClick"
                                    AutomationProperties.LiveSetting="Polite"
                                    AutomationProperties.AutomationId="OfflineIndicator">
                                    <!-- A cloud struck through: Google can't be reached -->
                                    <FontIcon Glyph="&#xEC9C;" FontSize="16" />
                                </Button>
                                <Button
                                    x:Name="WaitingButton"
                                    Style="{StaticResource LeafBareIconButtonStyle}"
                                    Visibility="Collapsed"
                                    Click="OnSyncStatusClick"
                                    AutomationProperties.LiveSetting="Polite"
                                    AutomationProperties.AutomationId="PendingChangesIndicator">
                                    <Grid>
                                        <FontIcon Glyph="&#xEC9C;" FontSize="16" />
                                        <!-- The negative margin lets the badge overlap the top-right corner of its 32 DIP icon button -->
                                        <InfoBadge
                                            x:Name="WaitingBadge"
                                            Margin="0,-6,-8,0"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Top"
                                            AutomationProperties.AccessibilityView="Raw" />
                                    </Grid>
                                </Button>
                            </Grid>
                            <!-- /Sync Status -->

                            <!-- View Menu (the label sits 1 px higher than centered and the Today text 1 px higher too, so the
                                 capitals' middles line up with the caption glyphs; the chevron stays centered) -->
                            <DropDownButton x:Name="ViewModeButton" Height="32" AutomationProperties.Name="Week" AutomationProperties.AutomationId="ViewModeButton">
                                <!-- One radio group marks the view showing (MainWindow.SyncMenu keeps it in step); the key text is the
                                     calendar's own shortcut, which also works while the menu is open (MainWindow.OnViewMenuKeyDown:
                                     on the open menu, and on every item for the Number of days submenu) -->
                                <DropDownButton.Flyout>
                                    <MenuFlyout x:Name="ViewMenu" Placement="BottomEdgeAlignedRight" Opened="OnViewMenuOpened" Closed="OnViewMenuClosed">
                                        <RadioMenuFlyoutItem x:Name="ViewDayItem" Text="Day" Tag="Day" GroupName="ViewMode" KeyboardAcceleratorTextOverride="D" Click="OnViewModeClick" PreviewKeyDown="OnViewMenuKeyDown" AutomationProperties.AutomationId="ViewDay" />
                                        <RadioMenuFlyoutItem x:Name="ViewWeekItem" Text="Week" Tag="Week" GroupName="ViewMode" KeyboardAcceleratorTextOverride="W" Click="OnViewModeClick" PreviewKeyDown="OnViewMenuKeyDown" AutomationProperties.AutomationId="ViewWeek" />
                                        <RadioMenuFlyoutItem x:Name="ViewMonthItem" Text="Month" Tag="Month" GroupName="ViewMode" KeyboardAcceleratorTextOverride="M" Click="OnViewModeClick" PreviewKeyDown="OnViewMenuKeyDown" AutomationProperties.AutomationId="ViewMonth" />
                                        <MenuFlyoutSubItem Text="Number of days" PreviewKeyDown="OnViewMenuKeyDown">
                                            <RadioMenuFlyoutItem x:Name="ViewDays2Item" Text="2 days" Tag="Days:2" GroupName="ViewMode" KeyboardAcceleratorTextOverride="2" Click="OnViewModeClick" PreviewKeyDown="OnViewMenuKeyDown" AutomationProperties.AutomationId="ViewDays2" />
                                            <RadioMenuFlyoutItem x:Name="ViewDays3Item" Text="3 days" Tag="Days:3" GroupName="ViewMode" KeyboardAcceleratorTextOverride="3" Click="OnViewModeClick" PreviewKeyDown="OnViewMenuKeyDown" AutomationProperties.AutomationId="ViewDays3" />
                                            <RadioMenuFlyoutItem x:Name="ViewDays4Item" Text="4 days" Tag="Days:4" GroupName="ViewMode" KeyboardAcceleratorTextOverride="4" Click="OnViewModeClick" PreviewKeyDown="OnViewMenuKeyDown" AutomationProperties.AutomationId="ViewDays4" />
                                            <RadioMenuFlyoutItem x:Name="ViewDays5Item" Text="5 days" Tag="Days:5" GroupName="ViewMode" KeyboardAcceleratorTextOverride="5" Click="OnViewModeClick" PreviewKeyDown="OnViewMenuKeyDown" AutomationProperties.AutomationId="ViewDays5" />
                                            <RadioMenuFlyoutItem x:Name="ViewDays6Item" Text="6 days" Tag="Days:6" GroupName="ViewMode" KeyboardAcceleratorTextOverride="6" Click="OnViewModeClick" PreviewKeyDown="OnViewMenuKeyDown" AutomationProperties.AutomationId="ViewDays6" />
                                            <RadioMenuFlyoutItem x:Name="ViewDays7Item" Text="7 days" Tag="Days:7" GroupName="ViewMode" KeyboardAcceleratorTextOverride="7" Click="OnViewModeClick" PreviewKeyDown="OnViewMenuKeyDown" AutomationProperties.AutomationId="ViewDays7" />
                                            <RadioMenuFlyoutItem x:Name="ViewDays8Item" Text="8 days" Tag="Days:8" GroupName="ViewMode" KeyboardAcceleratorTextOverride="8" Click="OnViewModeClick" PreviewKeyDown="OnViewMenuKeyDown" AutomationProperties.AutomationId="ViewDays8" />
                                            <RadioMenuFlyoutItem x:Name="ViewDays9Item" Text="9 days" Tag="Days:9" GroupName="ViewMode" KeyboardAcceleratorTextOverride="9" Click="OnViewModeClick" PreviewKeyDown="OnViewMenuKeyDown" AutomationProperties.AutomationId="ViewDays9" />
                                            <MenuFlyoutSeparator />
                                            <MenuFlyoutItem Text="Custom…" Click="OnCustomDaysClick" PreviewKeyDown="OnViewMenuKeyDown" AutomationProperties.AutomationId="ViewDaysCustom" />
                                        </MenuFlyoutSubItem>
                                    </MenuFlyout>
                                </DropDownButton.Flyout>
                                <TextBlock x:Name="ViewModeLabel" Margin="0,-1,0,0" Text="Week" />
                            </DropDownButton>
                            <Button
                                Style="{StaticResource LeafToolbarButtonStyle}"
                                Padding="10,0,10,1"
                                Content="Today"
                                Click="OnTodayClick"
                                ToolTipService.ToolTip="Today (T)"
                                AutomationProperties.AutomationId="TodayButton" />

                            <!-- Icon Buttons (plain icons, no hover or press fill; 32 wide and touching, so the glyphs sit 32 apart) -->
                            <StackPanel Orientation="Horizontal">
                                <Button
                                    Style="{StaticResource LeafBareIconButtonStyle}"
                                    Click="OnPreviousClick"
                                    ToolTipService.ToolTip="Previous (←)"
                                    AutomationProperties.Name="Previous"
                                    AutomationProperties.AutomationId="PreviousButton">
                                    <!-- The chevron turns a quarter to point up in Month view (MainWindow.RotatePagers, which gives it its rotation) -->
                                    <FontIcon x:Name="PreviousGlyph" Glyph="&#xE76B;" FontSize="12" RenderTransformOrigin="0.5,0.5" />
                                </Button>
                                <Button
                                    Style="{StaticResource LeafBareIconButtonStyle}"
                                    Click="OnNextClick"
                                    ToolTipService.ToolTip="Next (→)"
                                    AutomationProperties.Name="Next"
                                    AutomationProperties.AutomationId="NextButton">
                                    <!-- The chevron turns a quarter to point down in Month view -->
                                    <FontIcon x:Name="NextGlyph" Glyph="&#xE76C;" FontSize="12" RenderTransformOrigin="0.5,0.5" />
                                </Button>
                            </StackPanel>
                        </StackPanel>

                        <!-- Event Actions (the details panel's, in its title bar row; the edit glyph starts at the panel's content edge),
                             or the share panel's Delete saved times -->
                        <StackPanel
                            x:Name="EventActions"
                            HorizontalAlignment="Right"
                            Orientation="Horizontal"
                            Visibility="Collapsed">
                            <!-- Edit (the wrapper carries the tooltip, since a disabled button shows none) -->
                            <Border x:Name="EditEventTip" Background="Transparent">
                                <Button
                                    x:Name="EditEventButton"
                                    Style="{StaticResource LeafBareIconButtonStyle}"
                                    Click="OnEditEventClick"
                                    AutomationProperties.Name="Edit event"
                                    AutomationProperties.AutomationId="DetailsEditButton">
                                    <FontIcon Glyph="&#xE70F;" FontSize="16" />
                                </Button>
                            </Border>
                            <!-- /Edit -->

                            <!-- Delete -->
                            <Border x:Name="DeleteEventTip" Background="Transparent">
                                <Button
                                    x:Name="DeleteEventButton"
                                    Style="{StaticResource LeafBareIconButtonStyle}"
                                    Click="OnDeleteEventClick"
                                    AutomationProperties.Name="Delete event"
                                    AutomationProperties.AutomationId="DeleteEventButton">
                                    <FontIcon Glyph="&#xE74D;" FontSize="16" />
                                </Button>
                            </Border>
                            <!-- /Delete -->

                            <!-- Delete Saved Times (in Edit's place, the first spot, while the share panel shows a saved
                                 group: the right margin is the empty 32-wide spot the second button would take) -->
                            <Button
                                x:Name="DeleteSavedTimesButton"
                                Margin="0,0,32,0"
                                Style="{StaticResource LeafBareIconButtonStyle}"
                                Click="OnDeleteSavedTimesClick"
                                Visibility="Collapsed"
                                ToolTipService.ToolTip="Delete saved times"
                                AutomationProperties.Name="Delete saved times"
                                AutomationProperties.AutomationId="DeleteSavedTimesButton">
                                <FontIcon Glyph="&#xE74D;" FontSize="16" />
                            </Button>
                        </StackPanel>
                        <!-- /Event Actions -->
                    </Grid>
                    <!-- /Slide -->

                    <!-- Details Panel Toggle (always beside the caption buttons, whether the panel is open or closed; the
                         toolbar ends at its left edge while the panel is closed. Placed in code) -->
                    <ToggleButton
                        x:Name="DetailsToggle"
                        HorizontalAlignment="Right"
                        Style="{StaticResource LeafBareIconButtonStyle}"
                        Click="OnDetailsToggleClick"
                        ToolTipService.ToolTip="Details panel"
                        AutomationProperties.Name="Details panel"
                        AutomationProperties.AutomationId="DetailsToggleButton">
                        <!-- The details glyph: its right panel filled while the panel is open -->
                        <controls:PaneGlyph Pane="Details" Foreground="{x:Bind DetailsToggle.Foreground, Mode=OneWay}" />
                    </ToggleButton>
                </Grid>
            </TitleBar.Content>
            <!-- /Toolbar -->
        </TitleBar>
        <!-- /Title Bar -->

        <!-- Command Menu Dim (over the whole window, title bar row included, while the command menu is open; it appears and
             disappears at once with the menu, and the menu's own light dismiss closes it on a click here) -->
        <Border
            x:Name="CommandMenuDim"
            Grid.RowSpan="2"
            Background="{ThemeResource SmokeFillColorDefaultBrush}"
            Opacity="0"
            Visibility="Collapsed"
            AutomationProperties.Name="Command menu backdrop"
            AutomationProperties.AutomationId="CommandMenuDim" />
    </Grid>
</Window>
