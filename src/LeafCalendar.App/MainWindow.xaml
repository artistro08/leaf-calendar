<Window
    x:Class="LeafCalendar.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Leaf Calendar">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Content (the calendar runs under the title bar, so it spans the title bar row) -->
        <Frame x:Name="ContentFrame" Grid.RowSpan="2" Navigated="OnNavigated" />

        <!-- Title Bar -->
        <TitleBar
            x:Name="AppTitleBar"
            Title="Leaf Calendar"
            IsBackButtonVisible="False"
            IsPaneToggleButtonVisible="False"
            PaneToggleRequested="OnPaneToggleRequested"
            BackRequested="OnBackRequested"
            AutomationProperties.AutomationId="AppTitleBar">
            <TitleBar.Resources>
                <x:Double x:Key="TitleBarCompactHeight">48</x:Double>
                <x:Double x:Key="TitleBarMinDragRegionWidth">8</x:Double>
                <HorizontalAlignment x:Key="TitleBarContentHorizontalAlignment">Stretch</HorizontalAlignment>
                <StaticResource x:Key="TitleBarPaneToggleButtonStyle" ResourceKey="LeafTitleBarPaneToggleButtonStyle" />
            </TitleBar.Resources>
            <TitleBar.IconSource>
                <ImageIconSource ImageSource="ms-appx:///Assets/Square44x44Logo.png" />
            </TitleBar.IconSource>

            <!-- Search (opens the command menu): the first thing in the left sidebar's title bar row, right after the
                 pane toggle, as the edit and delete icons start the details panel's row -->
            <TitleBar.LeftHeader>
                <Button
                    x:Name="SearchButton"
                    Style="{StaticResource LeafBareIconButtonStyle}"
                    Click="OnSearchClick"
                    ToolTipService.ToolTip="Search (Ctrl+K)"
                    AutomationProperties.Name="Search"
                    AutomationProperties.AutomationId="SearchButton">
                    <FontIcon Glyph="&#xE721;" FontSize="16" />
                </Button>
            </TitleBar.LeftHeader>

            <!-- Toolbar (only its buttons take clicks; the space around them drags the window) -->
            <TitleBar.Content>
                <Grid x:Name="ToolbarHost">
                    <!-- Slide (the toolbar and the edit icon follow the island's right edge together) -->
                    <Grid x:Name="ToolbarSlide">
                        <StackPanel
                            x:Name="CalendarToolbar"
                            HorizontalAlignment="Right"
                            Orientation="Horizontal"
                            Spacing="4"
                            Visibility="Collapsed">
                            <!-- Sync Status (one 32 DIP slot, shown only when something needs attention, one state at a time:
                                 conflicts, then offline, then changes waiting. Offline with changes waiting, the waiting button
                                 takes the offline glyph and sits exactly over the offline one, so both can be read at once) -->
                            <Grid x:Name="SyncStatus" Width="32" Height="32" Visibility="Collapsed">
                                <Button
                                    x:Name="ConflictsButton"
                                    Style="{StaticResource LeafBareIconButtonStyle}"
                                    Visibility="Collapsed"
                                    Click="OnConflictsClick"
                                    AutomationProperties.AutomationId="ConflictsButton">
                                    <Grid>
                                        <FontIcon Glyph="&#xE7BA;" FontSize="16" />
                                        <InfoBadge
                                            x:Name="ConflictsBadge"
                                            Margin="0,-6,-8,0"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Top"
                                            AutomationProperties.AccessibilityView="Raw" />
                                    </Grid>
                                </Button>
                                <Button
                                    x:Name="OfflineButton"
                                    Style="{StaticResource LeafBareIconButtonStyle}"
                                    Visibility="Collapsed"
                                    Click="OnSyncStatusClick"
                                    AutomationProperties.AutomationId="OfflineIndicator">
                                    <FontIcon Glyph="&#xF384;" FontSize="16" />
                                </Button>
                                <Button
                                    x:Name="WaitingButton"
                                    Style="{StaticResource LeafBareIconButtonStyle}"
                                    Visibility="Collapsed"
                                    Click="OnSyncStatusClick"
                                    AutomationProperties.AutomationId="PendingChangesIndicator">
                                    <Grid>
                                        <FontIcon x:Name="WaitingGlyph" Glyph="&#xE895;" FontSize="16" />
                                        <InfoBadge
                                            x:Name="WaitingBadge"
                                            Margin="0,-6,-8,0"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Top"
                                            AutomationProperties.AccessibilityView="Raw" />
                                    </Grid>
                                </Button>
                            </Grid>
                            <!-- /Sync Status -->

                            <!-- View Menu (the label sits 1 px higher than centered and the Today text 1 px higher too, so the
                                 capitals' middles line up with the caption glyphs; the chevron stays centered) -->
                            <DropDownButton x:Name="ViewModeButton" Height="32" AutomationProperties.Name="Week" AutomationProperties.AutomationId="ViewModeButton">
                                <DropDownButton.Flyout>
                                    <MenuFlyout Placement="BottomEdgeAlignedRight">
                                        <MenuFlyoutItem Text="Day" Tag="Day" Click="OnViewModeClick" AutomationProperties.AutomationId="ViewDay" />
                                        <MenuFlyoutItem Text="Week" Tag="Week" Click="OnViewModeClick" AutomationProperties.AutomationId="ViewWeek" />
                                        <MenuFlyoutItem Text="Month" Tag="Month" Click="OnViewModeClick" AutomationProperties.AutomationId="ViewMonth" />
                                        <MenuFlyoutSubItem Text="Number of days">
                                            <MenuFlyoutItem Text="2 days" Tag="Days:2" Click="OnViewModeClick" AutomationProperties.AutomationId="ViewDays2" />
                                            <MenuFlyoutItem Text="3 days" Tag="Days:3" Click="OnViewModeClick" AutomationProperties.AutomationId="ViewDays3" />
                                            <MenuFlyoutItem Text="4 days" Tag="Days:4" Click="OnViewModeClick" AutomationProperties.AutomationId="ViewDays4" />
                                            <MenuFlyoutItem Text="5 days" Tag="Days:5" Click="OnViewModeClick" AutomationProperties.AutomationId="ViewDays5" />
                                            <MenuFlyoutItem Text="6 days" Tag="Days:6" Click="OnViewModeClick" AutomationProperties.AutomationId="ViewDays6" />
                                            <MenuFlyoutItem Text="7 days" Tag="Days:7" Click="OnViewModeClick" AutomationProperties.AutomationId="ViewDays7" />
                                            <MenuFlyoutItem Text="8 days" Tag="Days:8" Click="OnViewModeClick" AutomationProperties.AutomationId="ViewDays8" />
                                            <MenuFlyoutItem Text="9 days" Tag="Days:9" Click="OnViewModeClick" AutomationProperties.AutomationId="ViewDays9" />
                                            <MenuFlyoutSeparator />
                                            <MenuFlyoutItem Text="Custom…" Click="OnCustomDaysClick" AutomationProperties.AutomationId="ViewDaysCustom" />
                                        </MenuFlyoutSubItem>
                                    </MenuFlyout>
                                </DropDownButton.Flyout>
                                <TextBlock x:Name="ViewModeLabel" Margin="0,-1,0,0" Text="Week" />
                            </DropDownButton>
                            <Button
                                Style="{StaticResource LeafToolbarButtonStyle}"
                                Padding="10,0,10,1"
                                Content="Today"
                                Click="OnTodayClick"
                                ToolTipService.ToolTip="Today (T)"
                                AutomationProperties.AutomationId="TodayButton" />

                            <!-- Icon Buttons (plain icons, no hover or press fill; 32 wide and touching, so the glyphs sit 32 apart) -->
                            <StackPanel Orientation="Horizontal">
                                <Button
                                    Style="{StaticResource LeafBareIconButtonStyle}"
                                    Click="OnPreviousClick"
                                    ToolTipService.ToolTip="Previous (←)"
                                    AutomationProperties.Name="Previous"
                                    AutomationProperties.AutomationId="PreviousButton">
                                    <FontIcon Glyph="&#xE76B;" FontSize="12" />
                                </Button>
                                <Button
                                    Style="{StaticResource LeafBareIconButtonStyle}"
                                    Click="OnNextClick"
                                    ToolTipService.ToolTip="Next (→)"
                                    AutomationProperties.Name="Next"
                                    AutomationProperties.AutomationId="NextButton">
                                    <FontIcon Glyph="&#xE76C;" FontSize="12" />
                                </Button>
                                <ToggleButton
                                    x:Name="DetailsToggle"
                                    Style="{StaticResource LeafBareIconButtonStyle}"
                                    Click="OnDetailsToggleClick"
                                    ToolTipService.ToolTip="Details panel"
                                    AutomationProperties.Name="Details panel"
                                    AutomationProperties.AutomationId="DetailsToggleButton">
                                    <FontIcon Glyph="&#xE90D;" FontSize="16" />
                                </ToggleButton>
                            </StackPanel>
                        </StackPanel>

                        <!-- Event Actions (the details panel's, in its title bar row; the edit glyph starts at the panel's content edge) -->
                        <StackPanel
                            x:Name="EventActions"
                            HorizontalAlignment="Right"
                            Orientation="Horizontal"
                            Visibility="Collapsed">
                            <!-- Edit (the wrapper carries the tooltip, since a disabled button shows none) -->
                            <Border x:Name="EditEventTip" Background="Transparent">
                                <Button
                                    x:Name="EditEventButton"
                                    Style="{StaticResource LeafBareIconButtonStyle}"
                                    Click="OnEditEventClick"
                                    AutomationProperties.Name="Edit event"
                                    AutomationProperties.AutomationId="DetailsEditButton">
                                    <FontIcon Glyph="&#xE70F;" FontSize="16" />
                                </Button>
                            </Border>
                            <!-- /Edit -->

                            <!-- Delete -->
                            <Border x:Name="DeleteEventTip" Background="Transparent">
                                <Button
                                    x:Name="DeleteEventButton"
                                    Style="{StaticResource LeafBareIconButtonStyle}"
                                    Click="OnDeleteEventClick"
                                    AutomationProperties.Name="Delete event"
                                    AutomationProperties.AutomationId="DeleteEventButton">
                                    <FontIcon Glyph="&#xE74D;" FontSize="16" />
                                </Button>
                            </Border>
                            <!-- /Delete -->
                        </StackPanel>
                        <!-- /Event Actions -->
                    </Grid>
                    <!-- /Slide -->
                </Grid>
            </TitleBar.Content>
            <!-- /Toolbar -->
        </TitleBar>
        <!-- /Title Bar -->
    </Grid>
</Window>
