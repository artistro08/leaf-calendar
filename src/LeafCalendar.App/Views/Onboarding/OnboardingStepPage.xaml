<Page
    x:Class="LeafCalendar.App.Views.Onboarding.OnboardingStepPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- One Step (the navigation picks which panel shows; layout per the design standard: hero glyph, title, description, then controls) -->
    <ScrollViewer x:Name="PageScroll">
        <Grid Padding="32">

            <!-- Welcome -->
            <StackPanel x:Name="WelcomeStep" Spacing="16" Visibility="Collapsed" AutomationProperties.Name="Welcome to Leaf Calendar" AutomationProperties.AutomationId="OnboardingWelcome">
                <!-- The App's Logo (decoded at its 48 DIP size on screen, like the title bar's, so it isn't shrunk with jagged edges) -->
                <Image Width="48" Height="48" HorizontalAlignment="Left" AutomationProperties.AccessibilityView="Raw">
                    <Image.Source>
                        <BitmapImage UriSource="ms-appx:///Assets/AppLogo.png" DecodePixelWidth="48" DecodePixelHeight="48" DecodePixelType="Logical" />
                    </Image.Source>
                </Image>
                <StackPanel Spacing="4">
                    <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Welcome to Leaf Calendar" />
                    <TextBlock Style="{StaticResource LeafSecondaryTextStyle}" TextWrapping="Wrap" Text="Your Google Calendar in a fast, native Windows app." />
                </StackPanel>
                <TextBlock TextWrapping="Wrap" Text="Setup takes a few minutes. You'll connect your own Google Cloud OAuth client, sign in with Google, and Leaf will sync your calendars." />
            </StackPanel>
            <!-- /Welcome -->

            <!-- Google Cloud OAuth Client -->
            <StackPanel x:Name="ClientStep" Spacing="16" Visibility="Collapsed" AutomationProperties.Name="Connect your Google Cloud client" AutomationProperties.AutomationId="OnboardingClient">
                <FontIcon HorizontalAlignment="Left" FontSize="48" Glyph="&#xE8D7;" AutomationProperties.AccessibilityView="Raw" />
                <StackPanel Spacing="4">
                    <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Connect your Google Cloud client" />
                    <TextBlock Style="{StaticResource LeafSecondaryTextStyle}" TextWrapping="Wrap" Text="Leaf signs in with your own Google OAuth client. You only need to do this once." />
                </StackPanel>

                <!-- Setup Guide (Google Cloud console as of 2025, where the consent screen and clients live under Google Auth
                     Platform; numbers hang to the left of their wrapped lines; the link opens a fixed address) -->
                <StackPanel Spacing="8" AutomationProperties.Name="Setup guide" AutomationProperties.AutomationId="SetupGuideText">
                    <Grid ColumnSpacing="4" ColumnDefinitions="Auto,*">
                        <TextBlock Text="1." />
                        <TextBlock Grid.Column="1" TextWrapping="Wrap">
                            Open
                            <Hyperlink Click="OnConsoleLinkClick" AutomationProperties.AutomationId="ConsoleLink">
                                Google Cloud Console
                            </Hyperlink>
                            and create a project.
                        </TextBlock>
                    </Grid>
                    <Grid ColumnSpacing="4" ColumnDefinitions="Auto,*">
                        <TextBlock Text="2." />
                        <TextBlock Grid.Column="1" TextWrapping="Wrap" Text="In APIs &amp; Services › Library, enable the Google Calendar API and the People API." />
                    </Grid>
                    <Grid ColumnSpacing="4" ColumnDefinitions="Auto,*">
                        <TextBlock Text="3." />
                        <TextBlock Grid.Column="1" TextWrapping="Wrap" Text="In Google Auth Platform, click Get started and choose External as the audience. Then, in Audience, click Publish app. While it's in Testing, Google signs you out every 7 days." />
                    </Grid>
                    <Grid ColumnSpacing="4" ColumnDefinitions="Auto,*">
                        <TextBlock Text="4." />
                        <TextBlock Grid.Column="1" TextWrapping="Wrap" Text="In Google Auth Platform › Clients, create a client of type Desktop app. Paste its Client ID and Client secret below. Google shows the secret only once." />
                    </Grid>

                    <!-- Scopes (a side note, not a step) -->
                    <TextBlock
                        Style="{StaticResource LeafSecondaryTextStyle}"
                        TextWrapping="Wrap"
                        Text="Leaf asks Google for your calendars, your contacts and other contacts (read-only), and your Google Workspace directory (directory.readonly, so coworkers show up as guest suggestions). If you list scopes in Data access, add these." />
                </StackPanel>
                <!-- /Setup Guide -->

                <!-- Credentials, side by side so both show without scrolling (Enter in the ID moves to the secret; Enter in the
                     secret runs Next, which stays off until both have text) -->
                <Grid ColumnSpacing="12" ColumnDefinitions="*,*">
                    <TextBox
                        x:Name="ClientIdBox"
                        Header="Client ID"
                        PlaceholderText="123-abc.apps.googleusercontent.com"
                        Text="{x:Bind ViewModel.Client.ClientId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        KeyDown="OnClientIdKeyDown"
                        AutomationProperties.AutomationId="ClientIdBox" />
                    <PasswordBox
                        x:Name="ClientSecretBox"
                        Grid.Column="1"
                        Header="Client secret"
                        Password="{x:Bind ViewModel.Client.ClientSecret, Mode=TwoWay}"
                        KeyDown="OnClientSecretKeyDown"
                        AutomationProperties.AutomationId="ClientSecretBox" />
                </Grid>
                <InfoBar
                    CloseButtonStyle="{StaticResource LeafInfoBarCloseButtonStyle}"
                    Severity="Error"
                    IsClosable="False"
                    IsOpen="{x:Bind ViewModel.Client.HasError, Mode=OneWay}"
                    Message="{x:Bind ViewModel.Client.Error, Mode=OneWay}"
                    x:Name="ClientError"
                    AutomationProperties.LiveSetting="Assertive"
                    AutomationProperties.AutomationId="SetupError" />
            </StackPanel>
            <!-- /Google Cloud OAuth Client -->

            <!-- Sign In -->
            <StackPanel x:Name="SignInStep" Spacing="16" Visibility="Collapsed" AutomationProperties.Name="Sign in with Google" AutomationProperties.AutomationId="OnboardingSignIn">
                <FontIcon HorizontalAlignment="Left" FontSize="48" Glyph="&#xE77B;" AutomationProperties.AccessibilityView="Raw" />
                <StackPanel Spacing="4">
                    <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Sign in with Google" />
                    <TextBlock Style="{StaticResource LeafSecondaryTextStyle}" TextWrapping="Wrap" Text="Leaf opens your browser so you can sign in and let Leaf use your calendars." />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="8" Visibility="{x:Bind ViewModel.HasStatus, Mode=OneWay}">
                    <ProgressRing Width="20" Height="20" IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}" />
                    <TextBlock
                        VerticalAlignment="Center"
                        Style="{StaticResource LeafSecondaryTextStyle}"
                        TextWrapping="Wrap"
                        Text="{x:Bind ViewModel.Status, Mode=OneWay}"
                        AutomationProperties.AutomationId="OnboardingSignInStatus" />
                </StackPanel>
                <InfoBar
                    CloseButtonStyle="{StaticResource LeafInfoBarCloseButtonStyle}"
                    Severity="Error"
                    IsClosable="False"
                    IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}"
                    Message="{x:Bind ViewModel.Error, Mode=OneWay}"
                    x:Name="SignInError"
                    AutomationProperties.LiveSetting="Assertive"
                    AutomationProperties.AutomationId="OnboardingSignInError" />
            </StackPanel>
            <!-- /Sign In -->

            <!-- Syncing -->
            <StackPanel x:Name="SyncingStep" Spacing="16" Visibility="Collapsed" AutomationProperties.Name="Syncing your calendars" AutomationProperties.AutomationId="OnboardingSyncing">
                <FontIcon HorizontalAlignment="Left" FontSize="48" Glyph="&#xE72C;" AutomationProperties.AccessibilityView="Raw" />
                <StackPanel Spacing="4">
                    <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Syncing your calendars" />
                    <TextBlock Style="{StaticResource LeafSecondaryTextStyle}" TextWrapping="Wrap" Text="Leaf is downloading your calendars and events. This can take a minute." />
                </StackPanel>
                <StackPanel Spacing="8" Visibility="{x:Bind ViewModel.IsBusy, Mode=OneWay}">
                    <ProgressBar IsIndeterminate="True" AutomationProperties.AutomationId="OnboardingSyncProgress" />
                    <TextBlock Style="{StaticResource LeafSecondaryTextStyle}" TextWrapping="Wrap" Text="{x:Bind ViewModel.Status, Mode=OneWay}" />
                    <TextBlock
                        Style="{StaticResource LeafSecondaryTextStyle}"
                        Text="{x:Bind ViewModel.SyncSummary, Mode=OneWay}"
                        AutomationProperties.AutomationId="OnboardingSyncCounts" />
                </StackPanel>
                <InfoBar
                    CloseButtonStyle="{StaticResource LeafInfoBarCloseButtonStyle}"
                    Severity="Error"
                    IsClosable="False"
                    IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}"
                    Message="{x:Bind ViewModel.Error, Mode=OneWay}"
                    x:Name="SyncError"
                    AutomationProperties.LiveSetting="Assertive"
                    AutomationProperties.AutomationId="OnboardingSyncError" />
            </StackPanel>
            <!-- /Syncing -->

            <!-- Done -->
            <StackPanel x:Name="DoneStep" Spacing="16" Visibility="Collapsed" AutomationProperties.Name="You're all set" AutomationProperties.AutomationId="OnboardingDone">
                <FontIcon HorizontalAlignment="Left" FontSize="48" Glyph="&#xE73E;" AutomationProperties.AccessibilityView="Raw" />
                <StackPanel Spacing="4">
                    <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="You're all set" />
                    <TextBlock Style="{StaticResource LeafSecondaryTextStyle}" TextWrapping="Wrap" Text="Leaf synced your Google Calendar. You can add more accounts in Settings › Accounts." />
                </StackPanel>
                <StackPanel Spacing="0">
                    <TextBlock Text="{x:Bind ViewModel.Email, Mode=OneWay}" TextTrimming="CharacterEllipsis" AutomationProperties.AutomationId="OnboardingEmail" />
                    <TextBlock
                        Style="{StaticResource LeafSecondaryTextStyle}"
                        Text="{x:Bind ViewModel.SyncSummary, Mode=OneWay}"
                        AutomationProperties.AutomationId="OnboardingSyncSummary" />
                </StackPanel>
            </StackPanel>
            <!-- /Done -->

        </Grid>
    </ScrollViewer>
    <!-- /One Step -->
</Page>
