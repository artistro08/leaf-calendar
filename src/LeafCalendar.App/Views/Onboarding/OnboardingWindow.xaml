<Window
    x:Class="LeafCalendar.App.Views.Onboarding.OnboardingWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Set up Leaf Calendar">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="RootGrid" AutomationProperties.AutomationId="OnboardingRoot">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Title Bar (app icon and name; the window draws only Close, which sits on the edge) -->
        <TitleBar
            x:Name="AppTitleBar"
            Title="Leaf Calendar"
            IsBackButtonVisible="False"
            IsPaneToggleButtonVisible="False"
            AutomationProperties.AutomationId="OnboardingTitleBar">
            <TitleBar.Resources>
                <x:Double x:Key="TitleBarCompactHeight">48</x:Double>
                <x:Double x:Key="TitleBarMinDragRegionWidth">0</x:Double>
            </TitleBar.Resources>
            <TitleBar.IconSource>
                <ImageIconSource ImageSource="ms-appx:///Assets/AppLogo16.png" />
            </TitleBar.IconSource>
        </TitleBar>

        <!-- Steps (each slides in: from the right going forward, from the left going back) -->
        <Frame x:Name="StepFrame" Grid.Row="1" />

        <!-- Footer (pinned: Back, or Cancel while sign-in waits, on the left; the step indicator centered; the step's primary action on the right) -->
        <Border
            Grid.Row="2"
            Padding="24,16"
            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
            BorderThickness="0,1,0,0">
            <Grid ColumnDefinitions="*,Auto,*">
                <Button
                    HorizontalAlignment="Left"
                    Content="Back"
                    Click="OnBackClick"
                    Visibility="{x:Bind ViewModel.CanGoBack, Mode=OneWay}"
                    AutomationProperties.AutomationId="OnboardingBackButton" />
                <Button
                    HorizontalAlignment="Left"
                    Content="Cancel"
                    Click="OnCancelClick"
                    Visibility="{x:Bind ViewModel.CanCancel, Mode=OneWay}"
                    AutomationProperties.AutomationId="OnboardingCancelButton" />

                <!-- Step Indicator (a stock PipsPager, display only, with each pip drawn as a line; the PipsPager's own
                     automation peer always names itself "Pager", so a named wrapper says "Step 2 of 5" instead) -->
                <Grid
                    Grid.Column="1"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    AutomationProperties.Name="{x:Bind ViewModel.StepName, Mode=OneWay}"
                    AutomationProperties.AutomationId="StepIndicator">
                    <PipsPager
                        x:Name="StepPips"
                        IsHitTestVisible="False"
                        NormalPipStyle="{StaticResource LeafStepPipStyle}"
                        SelectedPipStyle="{StaticResource LeafSelectedStepPipStyle}"
                        SelectedPageIndex="{x:Bind ViewModel.PageIndex, Mode=OneWay}"
                        AutomationProperties.AccessibilityView="Raw" />
                </Grid>

                <Button
                    Grid.Column="2"
                    HorizontalAlignment="Right"
                    Style="{StaticResource AccentButtonStyle}"
                    Content="{x:Bind ViewModel.PrimaryText, Mode=OneWay}"
                    IsEnabled="{x:Bind ViewModel.CanRunPrimary, Mode=OneWay}"
                    Click="OnPrimaryClick"
                    AutomationProperties.AutomationId="OnboardingPrimaryButton" />
            </Grid>
        </Border>
        <!-- /Footer -->
    </Grid>
</Window>
