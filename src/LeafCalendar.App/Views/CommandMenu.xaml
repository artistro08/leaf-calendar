<UserControl
    x:Class="LeafCalendar.App.Views.CommandMenu"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:LeafCalendar.App.Controls"
    xmlns:local="using:LeafCalendar.App.Views"
    Width="640"
    AutomationProperties.Name="Command menu"
    AutomationProperties.AutomationId="CommandMenu">

    <UserControl.Resources>
        <!-- Key Cap (one key of a shortcut, PowerToys legend style: the same caps as ShortcutLegend, radius 4, Caption size) -->
        <Style x:Key="CommandKeyCapStyle" TargetType="controls:KeyVisual" BasedOn="{StaticResource DefaultKeyVisualStyle}">
            <Setter Property="MinWidth" Value="24" />
            <Setter Property="Padding" Value="8,2" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="CornerRadius" Value="4" />
        </Style>
    </UserControl.Resources>

    <!-- Command Menu (search row, divider, results or the empty state, footer); transparent, so the flyout's acrylic shows -->
    <StackPanel>
        <!-- Search Row (a leading search glyph, then a borderless box), lined up with the rows below: the glyph centered
             in the rows' 28 glyph column (8 list inset + 16 row padding in), the typed text starting where row titles do
             (the box's own 10 text inset after a 2 margin) -->
        <Grid Padding="24,12,16,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Search Glyph (hidden while the mode chip shows) -->
            <Grid x:Name="SearchGlyph" Width="28">
                <FontIcon
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    FontSize="16"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Glyph="&#xE721;"
                    AutomationProperties.AccessibilityView="Raw" />
            </Grid>

            <!-- Mode Chip (Jump to date: the action's glyph and name; what's typed is read as a date) -->
            <Border
                x:Name="ModeChip"
                Grid.Column="1"
                Padding="8,4"
                VerticalAlignment="Center"
                Background="{ThemeResource AccentFillColorDefaultBrush}"
                CornerRadius="4"
                Visibility="Collapsed">
                <!-- The chip's text carries its automation ID (a Border isn't in the UI Automation tree) -->
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon x:Name="ModeGlyph" FontSize="12" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" AutomationProperties.AccessibilityView="Raw" />
                    <TextBlock x:Name="ModeText" FontSize="12" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" AutomationProperties.AutomationId="CommandModeChip" />
                </StackPanel>
            </Border>

            <!-- Search Box (Alt+Enter jumps to the selected event; WinUI routes it as a system key, so it's an accelerator) -->
            <TextBox
                x:Name="CommandSearchBox"
                Grid.Column="2"
                Margin="2,0,0,0"
                MinHeight="32"
                VerticalAlignment="Center"
                Background="Transparent"
                BorderThickness="0"
                FontSize="16"
                PlaceholderForeground="{ThemeResource TextFillColorTertiaryBrush}"
                PlaceholderText="Search events, or type a command or a date"
                TextChanged="OnTextChanged"
                PreviewKeyDown="OnSearchKeyDown"
                KeyboardAcceleratorPlacementMode="Hidden"
                AutomationProperties.Name="Search"
                AutomationProperties.AutomationId="CommandSearchBox">
                <TextBox.Resources>
                    <!-- No fill and no focus underline: the row is the field -->
                    <SolidColorBrush x:Key="TextControlBackground" Color="Transparent" />
                    <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="Transparent" />
                    <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="Transparent" />
                    <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="Transparent" />
                    <Thickness x:Key="TextControlBorderThemeThicknessFocused">0</Thickness>
                </TextBox.Resources>
                <TextBox.KeyboardAccelerators>
                    <KeyboardAccelerator Key="Enter" Modifiers="Menu" Invoked="OnJumpInvoked" />
                </TextBox.KeyboardAccelerators>
            </TextBox>
        </Grid>
        <!-- /Search Row -->

        <!-- Divider -->
        <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

        <!-- Nothing Found (above the list, where the "Create event" offer follows it) -->
        <StackPanel x:Name="CommandEmptyPanel" Padding="24,24,24,8" Spacing="8" Visibility="Collapsed">
            <FontIcon
                FontSize="24"
                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                Glyph="&#xE721;"
                AutomationProperties.AccessibilityView="Raw" />
            <TextBlock
                x:Name="CommandEmptyText"
                HorizontalAlignment="Center"
                Style="{StaticResource CaptionTextBlockStyle}"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                AutomationProperties.AutomationId="CommandEmpty" />
        </StackPanel>

        <!-- Results (the list doesn't scroll itself, so the scroller is ours and its indicator shows on hover; tall enough
             for the default actions, CommandMenu.ResultsMaxHeight, so it opens without a scroll) -->
        <ScrollViewer x:Name="ResultsScroll" MaxHeight="416">
            <controls:PinnedListView
                x:Name="CommandResults"
                Padding="8"
                SelectionMode="Single"
                IsItemClickEnabled="True"
                IsTabStop="False"
                ScrollViewer.VerticalScrollMode="Disabled"
                ScrollViewer.VerticalScrollBarVisibility="Disabled"
                ItemClick="OnItemClick"
                SelectionChanged="OnSelectionChanged"
                ContainerContentChanging="OnRowChanging"
                AutomationProperties.Name="Results"
                AutomationProperties.AutomationId="CommandResults">
                <!-- No row transitions: results change on every keystroke and must simply be there -->
                <controls:PinnedListView.ItemContainerTransitions>
                    <TransitionCollection />
                </controls:PinnedListView.ItemContainerTransitions>
                <controls:PinnedListView.Resources>
                    <!-- A plain rounded fill marks the selection, without the stock accent pill -->
                    <x:Boolean x:Key="ListViewItemSelectionIndicatorVisualEnabled">False</x:Boolean>
                </controls:PinnedListView.Resources>
                <controls:PinnedListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="AllowFocusOnInteraction" Value="False" />
                        <Setter Property="CornerRadius" Value="{ThemeResource ControlCornerRadius}" />
                    </Style>
                </controls:PinnedListView.ItemContainerStyle>
                <controls:PinnedListView.ItemTemplate>
                    <!-- Result Row Or Section Header (the container's height is set per kind in code: 44 or 28) -->
                    <DataTemplate x:DataType="local:CommandRow">
                        <Grid AutomationProperties.Name="{x:Bind Title}" AutomationProperties.AutomationId="{x:Bind AutomationId}">
                            <!-- Section Header -->
                            <TextBlock
                                Margin="0,0,0,4"
                                VerticalAlignment="Bottom"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="{x:Bind Title}"
                                Visibility="{x:Bind HeaderVisibility}" />

                            <!-- Row -->
                            <Grid ColumnSpacing="12" Visibility="{x:Bind RowVisibility}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="28" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!-- Event Color, Or The Action's Glyph -->
                                <Border
                                    Width="16"
                                    Height="16"
                                    CornerRadius="4"
                                    Background="{x:Bind local:CommandMenu.Brush(Color)}"
                                    Visibility="{x:Bind EventVisibility}" />
                                <FontIcon
                                    FontSize="20"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Glyph="{x:Bind Glyph}"
                                    Visibility="{x:Bind ActionVisibility}"
                                    AutomationProperties.AccessibilityView="Raw" />

                                <!-- Title And Detail, Side By Side (one line, trimmed to the row: a title's own column outgrew the menu) -->
                                <TextBlock
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    MaxLines="1"
                                    TextTrimming="CharacterEllipsis">
                                    <Run Text="{x:Bind Title}" /><Run Text="{x:Bind DetailGap}" /><Run Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind Detail}" />
                                </TextBlock>
                                <!-- Shortcut (each key on its own cap, like PowerToys' legends) -->
                                <ContentControl
                                    Grid.Column="2"
                                    VerticalAlignment="Center"
                                    IsTabStop="False"
                                    Content="{x:Bind local:CommandMenu.Legend(Keys)}"
                                    Visibility="{x:Bind KeysVisibility}" />
                            </Grid>
                            <!-- /Row -->
                        </Grid>
                    </DataTemplate>
                </controls:PinnedListView.ItemTemplate>
            </controls:PinnedListView>
        </ScrollViewer>
        <!-- /Results -->

        <!-- Footer (hints only: what the selected row is, and what Enter and Alt+Enter do). The label starts under the
             section headers (24 in) and the Enter cap ends under the rows' key caps (20 in: 8 padding, then 12 margin) -->
        <Border
            x:Name="CommandFooter"
            MinHeight="40"
            Padding="24,4,8,4"
            Background="{ThemeResource LeafFlyoutFooterBrush}"
            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
            BorderThickness="0,1,0,0">
            <Grid Margin="0,0,12,0" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock
                    x:Name="FooterKind"
                    VerticalAlignment="Center"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    AutomationProperties.AutomationId="CommandFooterKind" />

                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="16">
                    <!-- What Enter Does (Open, Run, Go): Enter -->
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <TextBlock
                            x:Name="FooterVerb"
                            VerticalAlignment="Center"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            AutomationProperties.AutomationId="CommandFooterVerb" />
                        <controls:KeyVisual Style="{StaticResource CommandKeyCapStyle}" RenderKeyAsGlyph="True" Content="{x:Bind controls:ShortcutLegend.CapContent('Enter')}" />
                    </StackPanel>

                    <!-- Go To Event: Alt+Enter (event rows only) -->
                    <StackPanel x:Name="FooterJump" Orientation="Horizontal" Spacing="4" Visibility="Collapsed">
                        <TextBlock VerticalAlignment="Center" Style="{StaticResource CaptionTextBlockStyle}" Text="Go to event" />
                        <controls:KeyVisual Style="{StaticResource CommandKeyCapStyle}" Content="Alt" />
                        <controls:KeyVisual Style="{StaticResource CommandKeyCapStyle}" RenderKeyAsGlyph="True" Content="{x:Bind controls:ShortcutLegend.CapContent('Enter')}" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>
        <!-- /Footer -->
    </StackPanel>
    <!-- /Command Menu -->
</UserControl>
