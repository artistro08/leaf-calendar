<Page
    x:Class="LeafCalendar.App.Views.Settings.TrayPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:LeafCalendar.App.Controls">

    <ScrollViewer x:Name="PageScroll">
        <!-- The column sits in a plain Grid, not straight in the scroller: a scroller's content is placed by its scroll
             engine from its desired width (its natural content width, since MaxWidth counts as a set width), so a
             capped, stretched column straight in the scroller lands right of center once the window is wider than it -->
        <Grid>
            <StackPanel Style="{StaticResource LeafSettingsPagePanelStyle}">
                <TextBlock Style="{StaticResource LeafSettingsPageTitleStyle}" Text="Tray" />

                <!-- Icon (first on the page, so no group header: "Icon" only repeated the row) -->
                <controls:SettingRow Glyph="&#xE91C;" Header="Show the tray icon" Description="When it's off, Leaf keeps running in the background, so sync, reminders, and the global shortcuts still work. To open Leaf, launch it again. To quit, use the command menu.">
                    <ToggleSwitch
                        x:Name="IconSwitch"
                        Style="{StaticResource LeafCardToggleSwitchStyle}"
                        Toggled="OnIconToggled"
                        AutomationProperties.Name="Show the tray icon"
                        AutomationProperties.AutomationId="TrayIconSwitch" />
                </controls:SettingRow>

                <!-- Flyout -->
                <TextBlock Style="{StaticResource LeafSettingsGroupHeaderStyle}" Text="Flyout" />
                <controls:SettingRow x:Name="DaysRow" Glyph="&#xE8FD;" Header="Days in the agenda">
                    <NumberBox
                        x:Name="DaysBox"
                        Width="240"
                        Minimum="1"
                        SpinButtonPlacementMode="Compact"
                        ValueChanged="OnDaysChanged"
                        AutomationProperties.Name="Days in the agenda"
                        AutomationProperties.AutomationId="FlyoutDaysNumberBox" />
                </controls:SettingRow>
                <controls:SettingRow Glyph="&#xE8BF;" Header="Include all-day events" Description="List all-day events at the top of each day.">
                    <ToggleSwitch
                        x:Name="AllDaySwitch"
                        Style="{StaticResource LeafCardToggleSwitchStyle}"
                        Toggled="OnAllDayToggled"
                        AutomationProperties.Name="Include all-day events"
                        AutomationProperties.AutomationId="FlyoutAllDaySwitch" />
                </controls:SettingRow>
                <!-- Next Meeting (part of the flyout group: a "Next event" header over this one row only repeated it) -->
                <controls:SettingRow Glyph="&#xE916;" Header="Next meeting" Description="How far ahead the flyout header and the tray icon's tooltip look for your next meeting.">
                    <ComboBox
                        x:Name="LookaheadBox"
                        Width="240"
                        SelectionChanged="OnLookaheadChanged"
                        AutomationProperties.Name="Next meeting"
                        AutomationProperties.AutomationId="LookaheadComboBox">
                        <ComboBoxItem Content="15 minutes" />
                        <ComboBoxItem Content="30 minutes" />
                        <ComboBoxItem Content="1 hour" />
                        <ComboBoxItem Content="2 hours" />
                        <ComboBoxItem Content="4 hours" />
                        <ComboBoxItem Content="8 hours" />
                    </ComboBox>
                </controls:SettingRow>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
