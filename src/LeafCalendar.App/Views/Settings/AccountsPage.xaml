<Page
    x:Class="LeafCalendar.App.Views.Settings.AccountsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:LeafCalendar.App.Controls"
    xmlns:vm="using:LeafCalendar.App.ViewModels"
    xmlns:local="using:LeafCalendar.App.Views.Settings">

    <ScrollViewer x:Name="PageScroll">
        <StackPanel Style="{StaticResource LeafSettingsPagePanelStyle}">
            <TextBlock Style="{StaticResource LeafSettingsPageTitleStyle}" Text="Accounts" />

            <!-- Status -->
            <InfoBar
                Margin="0,0,0,12"
                Severity="{x:Bind local:AccountsPage.SeverityFor(ViewModel.IsError), Mode=OneWay}"
                IsOpen="{x:Bind ViewModel.HasMessage, Mode=OneWay}"
                Message="{x:Bind ViewModel.Message, Mode=OneWay}"
                AutomationProperties.LiveSetting="{x:Bind local:AccountsPage.LiveFor(ViewModel.IsError), Mode=OneWay}"
                AutomationProperties.AutomationId="AccountsMessage" />

            <!-- Google Accounts -->
            <TextBlock Style="{StaticResource LeafSettingsGroupHeaderStyle}" Margin="0,0,0,8" Text="Google accounts" />
            <TextBlock
                Style="{StaticResource LeafSecondaryTextStyle}"
                Margin="0,0,0,8"
                Text="No accounts yet. Add your Google account to see your calendars."
                Visibility="{x:Bind ViewModel.HasNoAccounts, Mode=OneWay}" />
            <!-- One Expander Per Account (its options inside, like Windows' accounts) -->
            <ItemsControl x:Name="AccountList" IsTabStop="False" AutomationProperties.AutomationId="AccountsList">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Spacing="4" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:AccountSettingsRow">
                        <Expander
                            Style="{StaticResource LeafSettingExpanderStyle}"
                            IsExpanded="{x:Bind IsExpanded, Mode=TwoWay}"
                            AutomationProperties.Name="{x:Bind Email}"
                            AutomationProperties.AutomationId="{x:Bind ExpanderId}">
                            <Expander.Header>
                                <controls:SettingRow
                                    Style="{StaticResource LeafExpanderHeaderRowStyle}"
                                    Glyph="&#xE77B;"
                                    Header="{x:Bind Email}"
                                    Description="{x:Bind Summary}" />
                            </Expander.Header>
                            <StackPanel>
                                <controls:SettingRow
                                    Style="{StaticResource LeafExpanderItemRowStyle}"
                                    BorderThickness="0"
                                    Header="Google Meet by default"
                                    Description="Add a Google Meet link to new events in this account.">
                                    <ToggleSwitch
                                        Style="{StaticResource LeafCardToggleSwitchStyle}"
                                        IsOn="{x:Bind IsOn, Mode=TwoWay}"
                                        AutomationProperties.Name="Google Meet by default"
                                        AutomationProperties.AutomationId="{x:Bind SwitchId}" />
                                </controls:SettingRow>
                                <controls:SettingRow
                                    Style="{StaticResource LeafExpanderItemRowStyle}"
                                    Header="Disconnect"
                                    Description="Sign out and remove this account's calendars from this PC. Your Google Calendar isn't changed.">
                                    <Button
                                        Content="Disconnect"
                                        Tag="{x:Bind AccountId}"
                                        Click="OnDisconnectClick"
                                        AutomationProperties.AutomationId="{x:Bind DisconnectId}" />
                                </controls:SettingRow>
                            </StackPanel>
                        </Expander>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <!-- /One Expander Per Account -->
            <controls:SettingRow Glyph="&#xE8FA;" Header="Add a Google account" Description="Sign in with Google in your browser. Leaf then syncs its calendars.">
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <ProgressRing Width="20" Height="20" IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}" />
                    <Button
                        Style="{StaticResource AccentButtonStyle}"
                        Content="Add Google account"
                        Command="{x:Bind ViewModel.AddAccountCommand}"
                        AutomationProperties.AutomationId="AddAccountButton" />
                </StackPanel>
            </controls:SettingRow>
            <controls:SettingRow Glyph="&#xE77B;" Header="Main account" Description="Listed first, and used to look up people's free/busy times.">
                <ComboBox
                    x:Name="MainAccountBox"
                    MinWidth="180"
                    SelectionChanged="OnMainAccountChanged"
                    AutomationProperties.Name="Main account"
                    AutomationProperties.AutomationId="MainAccountBox" />
            </controls:SettingRow>

            <!-- New Events -->
            <TextBlock Style="{StaticResource LeafSettingsGroupHeaderStyle}" Text="New events" />
            <controls:SettingRow Glyph="&#xE787;" Header="Default calendar" Description="Where new events go. Leaf uses this instead of Google's default.">
                <ComboBox
                    x:Name="DefaultCalendarBox"
                    MinWidth="180"
                    SelectionChanged="OnDefaultCalendarChanged"
                    AutomationProperties.Name="Default calendar"
                    AutomationProperties.AutomationId="DefaultCalendarComboBox" />
            </controls:SettingRow>

            <!-- Sync -->
            <TextBlock Style="{StaticResource LeafSettingsGroupHeaderStyle}" Text="Sync" />
            <controls:SettingRow Glyph="&#xE72C;" Header="Sync now" Description="Leaf syncs on its own. Sync now to get the latest changes from Google right away.">
                <Button
                    Content="Sync now"
                    Command="{x:Bind ViewModel.SyncNowCommand}"
                    AutomationProperties.AutomationId="SyncNowButton" />
            </controls:SettingRow>

            <!-- OAuth Client -->
            <TextBlock Style="{StaticResource LeafSettingsGroupHeaderStyle}" Text="Google Cloud OAuth client" />
            <controls:SettingRow Glyph="&#xE8D7;" Header="OAuth client" Description="{x:Bind ViewModel.ClientId, Mode=OneWay}">
                <Button
                    Content="Change OAuth client"
                    Click="OnChangeClientClick"
                    IsEnabled="{x:Bind ViewModel.IsNotBusy, Mode=OneWay}"
                    AutomationProperties.AutomationId="ChangeClientButton" />
            </controls:SettingRow>
        </StackPanel>
    </ScrollViewer>
</Page>
