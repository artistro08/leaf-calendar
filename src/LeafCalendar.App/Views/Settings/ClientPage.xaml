<Page
    x:Class="LeafCalendar.App.Views.Settings.ClientPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:LeafCalendar.App.Controls">

    <ScrollViewer x:Name="PageScroll">
        <StackPanel MaxWidth="900" Spacing="4">
            <TextBlock Style="{StaticResource LeafSettingsPageTitleStyle}" Text="Change OAuth client" />

            <!-- Client -->
            <TextBlock Style="{StaticResource LeafSettingsGroupHeaderStyle}" Margin="0,0,0,8" Text="Google Cloud OAuth client" />
            <TextBlock
                Style="{StaticResource LeafSecondaryTextStyle}"
                Margin="0,0,0,8"
                TextWrapping="Wrap"
                Text="Leaf asks for your calendars, your contacts and other contacts (read-only), and your Google Workspace directory (directory.readonly, read-only, for coworker suggestions). If your consent screen lists its scopes, add these."
                AutomationProperties.AutomationId="ClientScopesText" />
            <controls:SettingRow Glyph="&#xE8D7;" Header="Client ID" Description="From your Desktop app OAuth client in Google Cloud Console.">
                <TextBox
                    Width="320"
                    PlaceholderText="123-abc.apps.googleusercontent.com"
                    Text="{x:Bind ViewModel.ClientId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    KeyDown="OnClientIdKeyDown"
                    AutomationProperties.Name="Client ID"
                    AutomationProperties.AutomationId="SettingsClientIdBox" />
            </controls:SettingRow>
            <controls:SettingRow Glyph="&#xE72E;" Header="Client secret" Description="Leaf keeps it in Windows Credential Locker.">
                <PasswordBox
                    x:Name="SecretBox"
                    Width="320"
                    Password="{x:Bind ViewModel.ClientSecret, Mode=TwoWay}"
                    KeyDown="OnSecretKeyDown"
                    AutomationProperties.Name="Client secret"
                    AutomationProperties.AutomationId="SettingsClientSecretBox" />
            </controls:SettingRow>

            <!-- Error -->
            <InfoBar
                Margin="0,8,0,0"
                Severity="Error"
                IsClosable="False"
                IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}"
                Message="{x:Bind ViewModel.Error, Mode=OneWay}"
                AutomationProperties.LiveSetting="Assertive"
                AutomationProperties.AutomationId="SettingsClientError" />

            <!-- Actions -->
            <StackPanel Margin="0,12,0,0" Orientation="Horizontal" Spacing="8">
                <Button
                    Style="{StaticResource AccentButtonStyle}"
                    Content="Save"
                    Command="{x:Bind ViewModel.SaveCommand}"
                    AutomationProperties.AutomationId="ClientSaveButton" />
                <Button
                    Content="Cancel"
                    Click="OnCancelClick"
                    AutomationProperties.AutomationId="ClientCancelButton" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
