<Page
    x:Class="LeafCalendar.App.Views.Settings.AboutPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:LeafCalendar.App.Controls"
    xmlns:local="using:LeafCalendar.App.Views.Settings">

    <ScrollViewer x:Name="PageScroll">
        <!-- The column sits in a plain Grid, not straight in the scroller: a scroller's content is placed by its scroll
             engine from its desired width (its natural content width, since MaxWidth counts as a set width), so a
             capped, stretched column straight in the scroller lands right of center once the window is wider than it -->
        <Grid>
            <StackPanel Style="{StaticResource LeafSettingsPagePanelStyle}">
                <TextBlock Style="{StaticResource LeafSettingsPageTitleStyle}" Text="About" />

                <!-- App (icon, name, version) -->
                <Border
                    MinHeight="68"
                    Padding="16"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource OverlayCornerRadius}">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Image
                            Width="32"
                            Height="32"
                            VerticalAlignment="Center"
                            AutomationProperties.AccessibilityView="Raw">
                            <!-- Decoded at its size on screen (32 DIP at this scale), so it isn't shrunk with jagged edges -->
                            <Image.Source>
                                <BitmapImage UriSource="ms-appx:///Assets/AppLogo.png" DecodePixelWidth="32" DecodePixelHeight="32" DecodePixelType="Logical" />
                            </Image.Source>
                        </Image>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Leaf Calendar" />
                            <TextBlock
                                Style="{StaticResource LeafSecondaryTextStyle}"
                                Text="{x:Bind local:AboutPage.VersionText}"
                                AutomationProperties.AutomationId="AboutVersion" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Links (fixed addresses only) -->
                <TextBlock Style="{StaticResource LeafSettingsGroupHeaderStyle}" Text="Links" />
                <controls:SettingRow Glyph="&#xE943;" Header="Source code" Description="Leaf Calendar is open source. See the code, report a problem, or get the latest release.">
                    <HyperlinkButton
                        Content="View on GitHub"
                        Click="OnGitHubClick"
                        AutomationProperties.AutomationId="GitHubLink" />
                </controls:SettingRow>
                <controls:SettingRow Glyph="&#xE8A5;" Header="Third-party notices" Description="Licenses for the open source software Leaf uses.">
                    <Button
                        Content="Open notices"
                        Click="OnNoticesClick"
                        AutomationProperties.AutomationId="NoticesButton" />
                </controls:SettingRow>

                <!-- Troubleshooting -->
                <TextBlock Style="{StaticResource LeafSettingsGroupHeaderStyle}" Text="Troubleshooting" />
                <controls:SettingRow Glyph="&#xE9F9;" Header="Logs" Description="Leaf's log never includes your events, guests, or searches.">
                    <Button
                        Content="Open log folder"
                        Click="OnOpenLogsClick"
                        AutomationProperties.AutomationId="OpenLogsButton" />
                </controls:SettingRow>
                <controls:SettingRow Glyph="&#xEBE8;" Header="Detailed logging" Description="Record the steps before a problem, with crash details, so it can be traced. Crash files can include bits of what was on screen. Turn it off when you're done.">
                    <ToggleSwitch
                        x:Name="DetailedLoggingSwitch"
                        Style="{StaticResource LeafCardToggleSwitchStyle}"
                        Toggled="OnDetailedLoggingToggled"
                        AutomationProperties.Name="Detailed logging"
                        AutomationProperties.AutomationId="DetailedLoggingSwitch" />
                </controls:SettingRow>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
