<Page
    x:Class="LeafCalendar.App.Views.Settings.CalendarsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:LeafCalendar.App.Controls"
    xmlns:vm="using:LeafCalendar.App.ViewModels"
    xmlns:local="using:LeafCalendar.App.Views.Settings">

    <ScrollViewer x:Name="PageScroll">
        <!-- The column sits in a plain Grid, not straight in the scroller: a scroller's content is placed by its scroll
             engine from its desired width (its natural content width, since MaxWidth counts as a set width), so a
             capped, stretched column straight in the scroller lands right of center once the window is wider than it -->
        <Grid>
            <StackPanel Style="{StaticResource LeafSettingsPagePanelStyle}">
                <TextBlock Style="{StaticResource LeafSettingsPageTitleStyle}" Text="Calendars" />

                <!-- Empty State -->
                <TextBlock
                    x:Name="EmptyText"
                    Style="{StaticResource LeafSecondaryTextStyle}"
                    Text="No calendars yet. Add a Google account in Accounts."
                    Visibility="Collapsed" />

                <!-- One Expander Per Account (its calendars inside, like Settings › Accounts; folding it folds the sidebar's
                     account too, so a fold is passed to the calendar rather than bound two-way) -->
                <controls:PinnedItemsControl x:Name="GroupList" IsTabStop="False" AutomationProperties.AutomationId="SettingsCalendarList">
                    <controls:PinnedItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Spacing="4" />
                        </ItemsPanelTemplate>
                    </controls:PinnedItemsControl.ItemsPanel>
                    <controls:PinnedItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:AccountGroup">
                            <Expander
                                Style="{StaticResource LeafSettingExpanderStyle}"
                                IsExpanded="{x:Bind IsExpanded, Mode=OneWay}"
                                Expanding="OnAccountExpanding"
                                Collapsed="OnAccountCollapsed"
                                Tag="{x:Bind}"
                                AutomationProperties.Name="{x:Bind Email, Mode=OneWay}"
                                AutomationProperties.AutomationId="{x:Bind local:CalendarsPage.ExpanderId(AccountId)}">
                                <Expander.Header>
                                    <controls:SettingRow
                                        Style="{StaticResource LeafExpanderHeaderRowStyle}"
                                        Glyph="&#xE8D4;"
                                        Header="{x:Bind Email, Mode=OneWay}" />
                                </Expander.Header>
                                <!-- Calendars (every row has the divider line above it; the -1 top margin tucks the first row's line
                                     under the header's own bottom edge, since the rows come from a template that can't tell
                                     which one is first) -->
                                <controls:PinnedItemsControl Margin="0,-1,0,0" ItemsSource="{x:Bind Calendars}" IsTabStop="False">
                                    <controls:PinnedItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:CalendarRow">
                                            <!-- Calendar Row (color picker, then the show/hide switch with its "Show in Leaf" label) -->
                                            <controls:SettingRow
                                                Style="{StaticResource LeafExpanderItemRowStyle}"
                                                Header="{x:Bind Name, Mode=OneWay}"
                                                Description="{x:Bind local:CalendarsPage.ColorSource(Info), Mode=OneWay}">
                                                <StackPanel Orientation="Horizontal" Spacing="16">
                                                    <DropDownButton
                                                        Click="OnColorClick"
                                                        Tag="{x:Bind}"
                                                        ToolTipService.ToolTip="Change color"
                                                        AutomationProperties.Name="{x:Bind local:CalendarsPage.ColorName(Name), Mode=OneWay}"
                                                        AutomationProperties.AutomationId="{x:Bind local:CalendarsPage.ColorId(Info)}">
                                                        <Ellipse Width="16" Height="16" Fill="{x:Bind local:CalendarsPage.BrushFor(Color), Mode=OneWay}" />
                                                    </DropDownButton>
                                                    <StackPanel Orientation="Horizontal" Spacing="12">
                                                        <TextBlock
                                                            VerticalAlignment="Center"
                                                            Text="Show in Leaf"
                                                            AutomationProperties.AccessibilityView="Raw" />
                                                        <ToggleSwitch
                                                            Style="{StaticResource LeafCardToggleSwitchStyle}"
                                                            IsOn="{x:Bind IsVisible, Mode=OneWay}"
                                                            Toggled="OnVisibleToggled"
                                                            Tag="{x:Bind}"
                                                            AutomationProperties.Name="{x:Bind local:CalendarsPage.ShowName(Name), Mode=OneWay}"
                                                            AutomationProperties.AutomationId="{x:Bind local:CalendarsPage.VisibleId(Info)}" />
                                                    </StackPanel>
                                                    <Button
                                                        Style="{StaticResource LeafIconButtonStyle}"
                                                        Click="OnMoreClick"
                                                        Tag="{x:Bind}"
                                                        ToolTipService.ToolTip="More options"
                                                        AutomationProperties.Name="{x:Bind local:CalendarsPage.MoreName(Name), Mode=OneWay}"
                                                        AutomationProperties.AutomationId="{x:Bind local:CalendarsPage.MoreId(Info)}">
                                                        <FontIcon Glyph="&#xE712;" FontSize="16" />
                                                    </Button>
                                                </StackPanel>
                                            </controls:SettingRow>
                                        </DataTemplate>
                                    </controls:PinnedItemsControl.ItemTemplate>
                                </controls:PinnedItemsControl>
                                <!-- /Calendars -->
                            </Expander>
                        </DataTemplate>
                    </controls:PinnedItemsControl.ItemTemplate>
                </controls:PinnedItemsControl>
                <!-- /One Expander Per Account -->

                <!-- Share Availability Message (where every new share starts; the share panel's changes are for that share only).
                     An open expander card holds the full-width box under the header; MaxLength is AvailabilityText.MaxMessageLength -->
                <Expander
                    Style="{StaticResource LeafSettingExpanderStyle}"
                    IsExpanded="True"
                    Margin="0,24,0,0"
                    AutomationProperties.Name="Share availability message"
                    AutomationProperties.AutomationId="DefaultShareMessageExpander">
                    <Expander.Header>
                        <controls:SettingRow
                            Style="{StaticResource LeafExpanderHeaderRowStyle}"
                            Glyph="&#xE8BD;"
                            Header="Share availability message"
                            Description="{}{times} is replaced with your proposed times." />
                    </Expander.Header>
                    <StackPanel Margin="16" Spacing="8">
                        <TextBox
                            x:Name="DefaultMessageBox"
                            AcceptsReturn="True"
                            TextWrapping="Wrap"
                            MinHeight="88"
                            MaxLength="2000"
                            PlaceholderText="Only the times"
                            LostFocus="OnDefaultMessageLostFocus"
                            AutomationProperties.Name="Share availability message"
                            AutomationProperties.AutomationId="DefaultShareMessageBox" />
                        <!-- Reset (Leaf's own message back), at the right like the Windows Settings reset buttons -->
                        <Button
                            HorizontalAlignment="Right"
                            Content="Reset to default"
                            Click="OnDefaultMessageReset"
                            AutomationProperties.AutomationId="DefaultShareMessageReset" />
                    </StackPanel>
                </Expander>
                <!-- /Share Availability Message -->
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
