<Page
    x:Class="LeafCalendar.App.Views.Settings.NotificationsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:LeafCalendar.App.Controls">

    <ScrollViewer x:Name="PageScroll">
        <!-- The column sits in a plain Grid, not straight in the scroller: a scroller's content is placed by its scroll
             engine from its desired width (its natural content width, since MaxWidth counts as a set width), so a
             capped, stretched column straight in the scroller lands right of center once the window is wider than it -->
        <Grid>
            <StackPanel Style="{StaticResource LeafSettingsPagePanelStyle}">
                <TextBlock Style="{StaticResource LeafSettingsPageTitleStyle}" Text="Notifications" />

                <!-- Meetings -->
                <TextBlock Style="{StaticResource LeafSettingsGroupHeaderStyle}" Margin="0,0,0,8" Text="Meetings" />
                <controls:SettingRow Glyph="&#xECC5;" Header="Reminder notifications" Description="Show a notification at your Google reminder times, with Join, Snooze, and Dismiss.">
                    <ToggleSwitch
                        x:Name="RemindersSwitch"
                        Style="{StaticResource LeafCardToggleSwitchStyle}"
                        Toggled="OnRemindersToggled"
                        AutomationProperties.Name="Reminder notifications"
                        AutomationProperties.AutomationId="RemindersSwitch" />
                </controls:SettingRow>
                <!-- Persistent Notifications (an expander, like Windows' Notifications: the switch in its header, and inside, the
                     events whose notifications stay on screen, off as one while the switch is off) -->
                <Expander
                    x:Name="JoinNowExpander"
                    Style="{StaticResource LeafSettingExpanderStyle}"
                    AutomationProperties.Name="Persistent “Join now” notification"
                    AutomationProperties.AutomationId="JoinNowExpander">
                    <Expander.Header>
                        <controls:SettingRow
                            Style="{StaticResource LeafExpanderHeaderRowStyle}"
                            Glyph="&#xE718;"
                            Header="Persistent “Join now” notification"
                            Description="Show “Join now” when a meeting with a link starts, and keep the notifications checked below on screen until you join, snooze, or dismiss them.">
                            <ToggleSwitch
                                x:Name="JoinNowSwitch"
                                Style="{StaticResource LeafCardToggleSwitchStyle}"
                                Toggled="OnJoinNowToggled"
                                AutomationProperties.Name="Persistent “Join now” notification"
                                AutomationProperties.AutomationId="JoinNowSwitch" />
                        </controls:SettingRow>
                    </Expander.Header>
                    <!-- Text On The Expander Rows' 48 DIP Edge, Lined Up With The Header's -->
                    <ContentControl x:Name="PersistRows" HorizontalContentAlignment="Stretch" IsTabStop="False">
                        <StackPanel Padding="48,8,16,8" Spacing="4">
                            <CheckBox
                                x:Name="PersistMeetingsBox"
                                Content="Stay persistent for meetings"
                                Click="OnPersistMeetingsClick"
                                AutomationProperties.AutomationId="PersistMeetingsBox" />
                            <CheckBox
                                x:Name="PersistAloneBox"
                                Content="Stay persistent for reminders"
                                Click="OnPersistAloneClick"
                                AutomationProperties.AutomationId="PersistAloneBox" />
                        </StackPanel>
                    </ContentControl>
                </Expander>
                <!-- /Persistent Notifications -->
                <controls:SettingRow Glyph="&#xE715;" Header="Invite notifications" Description="Show new and updated invitations with Yes, No, and Maybe buttons.">
                    <ToggleSwitch
                        x:Name="InvitesSwitch"
                        Style="{StaticResource LeafCardToggleSwitchStyle}"
                        Toggled="OnInvitesToggled"
                        AutomationProperties.Name="Invite notifications"
                        AutomationProperties.AutomationId="InvitesSwitch" />
                </controls:SettingRow>
                <!-- Sound (with the notifications it plays for: a "Sound" header over one "Sound" row only repeated it) -->
                <controls:SettingRow Glyph="&#xE767;" Header="Sound" Description="Play the Windows notification sound. Do not disturb and Focus in Windows still apply.">
                    <ToggleSwitch
                        x:Name="SoundSwitch"
                        Style="{StaticResource LeafCardToggleSwitchStyle}"
                        Toggled="OnSoundToggled"
                        AutomationProperties.Name="Sound"
                        AutomationProperties.AutomationId="SoundSwitch" />
                </controls:SettingRow>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
