<Page
    x:Class="LeafCalendar.App.Views.Settings.SchedulingPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:LeafCalendar.App.Controls">

    <ScrollViewer x:Name="PageScroll">
        <!-- The column sits in a plain Grid, not straight in the scroller: a scroller's content is placed by its scroll
             engine from its desired width (its natural content width, since MaxWidth counts as a set width), so a
             capped, stretched column straight in the scroller lands right of center once the window is wider than it -->
        <Grid>
            <StackPanel Style="{StaticResource LeafSettingsPagePanelStyle}">
                <TextBlock Style="{StaticResource LeafSettingsPageTitleStyle}" Text="Scheduling" />

                <!-- One Card Per Signed-In Provider: its default link, and its links each switched on or off (built in code
                     from SchedulingProviders.All, so a new provider needs no new page code) -->
                <StackPanel x:Name="ProviderList" Spacing="4" />

                <!-- Booking Link Note (added on its own line after the links Copy writes). An open expander card holds the
                     full-width box under the header; MaxLength is ShareLinks.MaxNoteLength -->
                <Expander
                    Style="{StaticResource LeafSettingExpanderStyle}"
                    IsExpanded="True"
                    Margin="0,24,0,0"
                    AutomationProperties.Name="Booking link note"
                    AutomationProperties.AutomationId="BookingLinkNoteExpander">
                    <Expander.Header>
                        <controls:SettingRow
                            Style="{StaticResource LeafExpanderHeaderRowStyle}"
                            Glyph="&#xE8BD;"
                            Header="Booking link note"
                            Description="Added on its own line after your booking links when you copy times." />
                    </Expander.Header>
                    <StackPanel Margin="16" Spacing="8">
                        <TextBox
                            x:Name="NoteBox"
                            AcceptsReturn="True"
                            TextWrapping="Wrap"
                            MinHeight="64"
                            MaxLength="500"
                            PlaceholderText="No note"
                            LostFocus="OnNoteLostFocus"
                            AutomationProperties.Name="Booking link note"
                            AutomationProperties.AutomationId="BookingLinkNoteBox" />
                        <!-- Reset (Leaf Calendar's own note back), at the right like the Windows Settings reset buttons -->
                        <Button
                            HorizontalAlignment="Right"
                            Content="Reset to default"
                            Click="OnNoteReset"
                            AutomationProperties.AutomationId="BookingLinkNoteReset" />
                    </StackPanel>
                </Expander>
                <!-- /Booking Link Note -->
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
