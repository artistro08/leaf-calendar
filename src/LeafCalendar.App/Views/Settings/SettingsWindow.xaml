<Window
    x:Class="LeafCalendar.App.Views.Settings.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Settings">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="RootGrid" AutomationProperties.AutomationId="SettingsRoot">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Title Bar (the stock back button on sub-pages, then the stock hamburger that opens and closes the navigation pane) -->
        <TitleBar
            x:Name="AppTitleBar"
            Title="Settings"
            IsBackButtonVisible="False"
            IsPaneToggleButtonVisible="True"
            BackRequested="OnBackRequested"
            PaneToggleRequested="OnPaneToggleRequested"
            AutomationProperties.AutomationId="SettingsTitleBar">
            <TitleBar.Resources>
                <x:Double x:Key="TitleBarCompactHeight">48</x:Double>
                <x:Double x:Key="TitleBarMinDragRegionWidth">8</x:Double>
            </TitleBar.Resources>
            <TitleBar.IconSource>
                <ImageIconSource>
                    <ImageIconSource.ImageSource>
                        <!-- Decoded at its size on screen (16 DIP at this scale), so it isn't shrunk with jagged edges -->
                        <BitmapImage UriSource="ms-appx:///Assets/AppLogo.png" DecodePixelWidth="16" DecodePixelHeight="16" DecodePixelType="Logical" />
                    </ImageIconSource.ImageSource>
                </ImageIconSource>
            </TitleBar.IconSource>
        </TitleBar>

        <!-- Navigation (items set in code from concrete lists; About sits at the bottom of the pane) -->
        <NavigationView
            x:Name="Navigation"
            Grid.Row="1"
            IsBackButtonVisible="Collapsed"
            IsPaneToggleButtonVisible="False"
            IsSettingsVisible="False"
            OpenPaneLength="240"
            PaneDisplayMode="Auto"
            ExpandedModeThresholdWidth="800"
            SelectionChanged="OnSelectionChanged"
            ItemInvoked="OnItemInvoked"
            AutomationProperties.AutomationId="SettingsNavigation">
            <!-- Each page insets its own content, so its scroll bar sits at the window's right edge -->
            <Frame x:Name="ContentFrame" />
        </NavigationView>
        <!-- /Navigation -->
    </Grid>
</Window>
