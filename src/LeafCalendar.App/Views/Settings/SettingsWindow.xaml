<Window
    x:Class="LeafCalendar.App.Views.Settings.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Settings">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="RootGrid" AutomationProperties.AutomationId="SettingsRoot">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Title Bar (the pane toggle opens and closes the navigation pane; same bare toggle as the main window) -->
        <TitleBar
            x:Name="AppTitleBar"
            Title="Settings"
            IsBackButtonVisible="False"
            IsPaneToggleButtonVisible="True"
            PaneToggleRequested="OnPaneToggleRequested"
            AutomationProperties.AutomationId="SettingsTitleBar">
            <TitleBar.Resources>
                <x:Double x:Key="TitleBarCompactHeight">48</x:Double>
                <x:Double x:Key="TitleBarMinDragRegionWidth">8</x:Double>
                <StaticResource x:Key="TitleBarPaneToggleButtonStyle" ResourceKey="LeafTitleBarPaneToggleButtonStyle" />
            </TitleBar.Resources>
            <TitleBar.IconSource>
                <ImageIconSource ImageSource="ms-appx:///Assets/Square44x44Logo.png" />
            </TitleBar.IconSource>
        </TitleBar>

        <!-- Navigation (items set in code from concrete lists; About sits at the bottom of the pane) -->
        <NavigationView
            x:Name="Navigation"
            Grid.Row="1"
            IsBackButtonVisible="Collapsed"
            IsPaneToggleButtonVisible="False"
            IsSettingsVisible="False"
            OpenPaneLength="240"
            PaneDisplayMode="Auto"
            ExpandedModeThresholdWidth="800"
            SelectionChanged="OnSelectionChanged"
            ItemInvoked="OnItemInvoked"
            AutomationProperties.AutomationId="SettingsNavigation">
            <Frame x:Name="ContentFrame" Padding="36,24" />
        </NavigationView>
        <!-- /Navigation -->
    </Grid>
</Window>
