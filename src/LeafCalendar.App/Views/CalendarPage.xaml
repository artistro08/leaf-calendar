<Page
    x:Class="LeafCalendar.App.Views.CalendarPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:LeafCalendar.App.Views"
    KeyboardAcceleratorPlacementMode="Hidden">

    <!-- The InfoBar's severity states paint their own see-through fill over Background; the notice is always Informational, so its fill is made solid here (Fluent's solid tertiary background; window color in high contrast) -->
    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <StaticResource x:Key="InfoBarInformationalSeverityBackgroundBrush" ResourceKey="SolidBackgroundFillColorTertiaryBrush" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <StaticResource x:Key="InfoBarInformationalSeverityBackgroundBrush" ResourceKey="SolidBackgroundFillColorTertiaryBrush" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="HighContrast">
                    <SolidColorBrush x:Key="InfoBarInformationalSeverityBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Page.Resources>

    <Page.KeyboardAccelerators>
        <KeyboardAccelerator Key="Escape" Invoked="OnEscapeInvoked" />
    </Page.KeyboardAccelerators>

    <!-- Three parts: the sidebar and the details panel on the window's Mica, and the calendar island between them.
         The panes lie over the page and slide by composition. The island slides with them: its left edge rides the
         sidebar's edge, its clip follows the details panel's edge, and its columns lay out once per toggle (at the
         start of a close, at the end of an open; CalendarPage.Panes.cs).
         The page runs under the title bar, so the top 48 px of each part sits in the title bar row. -->
    <Grid x:Name="Root" Background="Transparent" AutomationProperties.Name="Calendar" AutomationProperties.AutomationId="CalendarRoot">

        <!-- Sidebar Pane (first, so Tab and Narrator go sidebar, calendar, details; drawn over the island) -->
        <local:SidebarView
            x:Name="Sidebar"
            Canvas.ZIndex="2"
            Width="264"
            HorizontalAlignment="Left"
            AutomationProperties.Name="Sidebar"
            AutomationProperties.LandmarkType="Navigation"
            AutomationProperties.AutomationId="Sidebar" />

        <!-- Island Fill (the island's color; its edges follow the panes as they slide) -->
        <Border x:Name="IslandFill" Background="{ThemeResource LayerFillColorDefaultBrush}" />

        <!-- Island Area (its margins leave room for the open panes) -->
        <Grid x:Name="IslandArea">
            <!-- Island (flat, top to bottom; its fill against the Mica is the only edge) -->
            <Grid
                x:Name="Island"
                Background="Transparent"
                SizeChanged="OnIslandSizeChanged">
                <Grid.RowDefinitions>
                    <RowDefinition Height="49" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Period Title (under the title bar's drag area; the toolbar floats over the right end; the left inset is CalendarPage.TitleInset, set in code) -->
                <TextBlock
                    x:Name="PeriodTitle"
                    Margin="0,9,0,8"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    FontSize="22"
                    FontWeight="Bold"
                    TextTrimming="CharacterEllipsis"
                    AutomationProperties.AutomationId="PeriodTitle" />

                <!-- Island Bars (time travel, people overlay; each track adds its own bar from code) -->
                <StackPanel x:Name="IslandBars" Grid.Row="1" />

                <!-- View -->
                <Grid
                    x:Name="ViewHost"
                    Grid.Row="2"
                    Tapped="OnViewHostTapped"
                    AutomationProperties.Name="Calendar view"
                    AutomationProperties.LandmarkType="Main"
                    AutomationProperties.AutomationId="ViewHost" />

                <!-- Floating Cards (share availability: bottom right, over the view) -->
                <Grid
                    x:Name="FloatingCards"
                    Grid.Row="2"
                    Margin="0,0,16,16"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom" />

                <!-- Notice ("Event deleted · Undo"; solid so the grid never shows through) -->
                <InfoBar
                    x:Name="NoticeBar"
                    Grid.Row="2"
                    Margin="0,0,0,16"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Bottom"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    IsClosable="True"
                    Closed="OnNoticeClosed"
                    AutomationProperties.LiveSetting="Polite"
                    AutomationProperties.AutomationId="NoticeBar">
                    <InfoBar.ActionButton>
                        <Button
                            x:Name="UndoButton"
                            Content="Undo"
                            Click="OnUndoClick"
                            AutomationProperties.AutomationId="UndoButton" />
                    </InfoBar.ActionButton>
                </InfoBar>
                <!-- /Notice -->
            </Grid>
            <!-- /Island -->

            <!-- Empty State -->
            <StackPanel
                x:Name="EmptyState"
                Spacing="12"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Visibility="Collapsed"
                AutomationProperties.Name="No calendars yet"
                AutomationProperties.AutomationId="EmptyState">
                <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="No calendars yet" HorizontalAlignment="Center" />
                <TextBlock Text="Add a Google account to see your events here." Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" />
                <Button
                    Style="{StaticResource AccentButtonStyle}"
                    Content="Add a Google account"
                    HorizontalAlignment="Center"
                    Click="OnAddAccountClick"
                    AutomationProperties.AutomationId="EmptyAddAccountButton" />
            </StackPanel>
            <!-- /Empty State -->
        </Grid>
        <!-- /Island Area -->

        <!-- Details Pane (the details panel, or the share slots while sharing availability) -->
        <Grid x:Name="DetailsPane" Canvas.ZIndex="2" Width="320" HorizontalAlignment="Right">
            <local:DetailsPanel x:Name="Details" />
        </Grid>
        <!-- /Details Pane -->
    </Grid>
</Page>
