<Page
    x:Class="LeafCalendar.App.Views.CalendarPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:LeafCalendar.App.Views"
    KeyboardAcceleratorPlacementMode="Hidden">

    <!-- The InfoBar's severity states paint their own see-through fill over Background; the notice is always Informational, so its fill is made solid here (Fluent's solid tertiary background; window color in high contrast) -->
    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <StaticResource x:Key="InfoBarInformationalSeverityBackgroundBrush" ResourceKey="SolidBackgroundFillColorTertiaryBrush" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <StaticResource x:Key="InfoBarInformationalSeverityBackgroundBrush" ResourceKey="SolidBackgroundFillColorTertiaryBrush" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="HighContrast">
                    <SolidColorBrush x:Key="InfoBarInformationalSeverityBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Page.Resources>

    <Page.KeyboardAccelerators>
        <KeyboardAccelerator Key="Escape" Invoked="OnEscapeInvoked" />
    </Page.KeyboardAccelerators>

    <!-- Three parts: the sidebar and the details panel are the panes of two nested inline SplitViews
         (WinUI's own slide), on the window's Mica; the calendar island fills the space between them.
         The page runs under the title bar, so the top 48 px of each part sits in the title bar row. -->
    <Grid x:Name="Root" AutomationProperties.Name="Calendar" AutomationProperties.AutomationId="CalendarRoot">

        <!-- Sidebar Pane -->
        <SplitView
            x:Name="SidebarSplit"
            DisplayMode="Inline"
            PanePlacement="Left"
            OpenPaneLength="264"
            PaneBackground="Transparent"
            BorderThickness="0">
            <SplitView.Pane>
                <local:SidebarView
                    x:Name="Sidebar"
                    AutomationProperties.Name="Sidebar"
                    AutomationProperties.LandmarkType="Navigation"
                    AutomationProperties.AutomationId="Sidebar" />
            </SplitView.Pane>

            <!-- Details Pane -->
            <SplitView
                x:Name="DetailsSplit"
                DisplayMode="Inline"
                PanePlacement="Right"
                OpenPaneLength="320"
                PaneBackground="Transparent"
                BorderThickness="0"
                SizeChanged="OnDetailsSplitSizeChanged">
                <SplitView.Pane>
                    <local:DetailsPanel x:Name="Details" />
                </SplitView.Pane>

                <Grid>
                    <!-- Island (flat, top to bottom; its fill against the Mica is the only edge) -->
                    <Grid
                        x:Name="Island"
                        Background="{ThemeResource LayerFillColorDefaultBrush}"
                        SizeChanged="OnIslandSizeChanged">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="49" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- Period Title (under the title bar's drag area; the toolbar floats over the right end; the left inset is CalendarPage.TitleInset, set in code) -->
                        <TextBlock
                            x:Name="PeriodTitle"
                            Margin="0,9,0,8"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            FontSize="22"
                            FontWeight="Bold"
                            TextTrimming="CharacterEllipsis"
                            AutomationProperties.AutomationId="PeriodTitle" />

                        <!-- Island Bars (time travel, people overlay, share availability; each track adds its own bar from code) -->
                        <StackPanel x:Name="IslandBars" Grid.Row="1" />

                        <!-- View -->
                        <Grid
                            x:Name="ViewHost"
                            Grid.Row="2"
                            Tapped="OnViewHostTapped"
                            AutomationProperties.Name="Calendar view"
                            AutomationProperties.LandmarkType="Main"
                            AutomationProperties.AutomationId="ViewHost" />

                        <!-- Notice ("Event deleted · Undo"; solid so the grid never shows through) -->
                        <InfoBar
                            x:Name="NoticeBar"
                            Grid.Row="2"
                            Margin="0,0,0,16"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Bottom"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            IsClosable="True"
                            Closed="OnNoticeClosed"
                            AutomationProperties.LiveSetting="Polite"
                            AutomationProperties.AutomationId="NoticeBar">
                            <InfoBar.ActionButton>
                                <Button
                                    x:Name="UndoButton"
                                    Content="Undo"
                                    Click="OnUndoClick"
                                    AutomationProperties.AutomationId="UndoButton" />
                            </InfoBar.ActionButton>
                        </InfoBar>
                        <!-- /Notice -->
                    </Grid>
                    <!-- /Island -->

                    <!-- Empty State -->
                    <StackPanel
                        x:Name="EmptyState"
                        Spacing="12"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Visibility="Collapsed"
                        AutomationProperties.Name="No calendars yet"
                        AutomationProperties.AutomationId="EmptyState">
                        <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="No calendars yet" HorizontalAlignment="Center" />
                        <TextBlock Text="Add a Google account to see your events here." Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" />
                        <Button
                            Style="{StaticResource AccentButtonStyle}"
                            Content="Add a Google account"
                            HorizontalAlignment="Center"
                            Click="OnAddAccountClick"
                            AutomationProperties.AutomationId="EmptyAddAccountButton" />
                    </StackPanel>
                    <!-- /Empty State -->
                </Grid>
            </SplitView>
            <!-- /Details Pane -->
        </SplitView>
        <!-- /Sidebar Pane -->
    </Grid>
</Page>
