<UserControl
    x:Class="LeafCalendar.App.Views.ShareBar"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Visibility="Collapsed"
    AutomationProperties.AutomationId="ShareBar"
    AutomationProperties.Name="Share availability">

    <!-- Share Card: floats in the calendar view's bottom-right corner while you pick times (the times themselves are
         listed in the right panel). The zone and the calendars on the first row, Cancel and Copy on the second -->
    <Border x:Name="Card" Padding="16" Style="{StaticResource LeafFloatingCardStyle}">
        <Grid RowSpacing="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Zone And Calendars -->
            <StackPanel Orientation="Horizontal" Spacing="8">
                <ComboBox
                    x:Name="ShareZoneBox"
                    MinWidth="180"
                    SelectionChanged="OnZoneChanged"
                    AutomationProperties.AutomationId="ShareZoneBox"
                    AutomationProperties.Name="Time zone" />
                <DropDownButton
                    Content="Calendars"
                    AutomationProperties.AutomationId="ShareCalendarsButton">
                    <DropDownButton.Flyout>
                        <MenuFlyout x:Name="CalendarsMenu" Placement="Bottom" />
                    </DropDownButton.Flyout>
                </DropDownButton>
            </StackPanel>

            <!-- Cancel And Copy (the one accent on the surface) -->
            <StackPanel
                Grid.Row="1"
                HorizontalAlignment="Right"
                Orientation="Horizontal"
                Spacing="8">
                <Button
                    Content="Cancel"
                    Click="OnCancelClick"
                    AutomationProperties.AutomationId="ShareCancelButton" />
                <Button
                    x:Name="CopyButton"
                    Content="Copy"
                    Style="{StaticResource AccentButtonStyle}"
                    IsEnabled="False"
                    Click="OnCopyClick"
                    AutomationProperties.AutomationId="ShareCopyButton" />
            </StackPanel>
        </Grid>
    </Border>
    <!-- /Share Card -->
</UserControl>
