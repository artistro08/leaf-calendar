<UserControl
    x:Class="LeafCalendar.App.Views.OverlayBar"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:LeafCalendar.App.Controls"
    xmlns:local="using:LeafCalendar.App.Views"
    Visibility="Collapsed"
    AutomationProperties.AutomationId="OverlayBar"
    AutomationProperties.Name="People overlay">

    <!-- Overlay Bar: who is overlaid on the time grid (P, F, E then F), one chip each, and Clear -->
    <Border
        Margin="16,0,16,8"
        Padding="12,8"
        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
        BorderThickness="1"
        CornerRadius="8">
        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Label -->
            <StackPanel VerticalAlignment="Center">
                <TextBlock x:Name="Label" Style="{StaticResource CaptionTextBlockStyle}" Text="Busy times" />
                <TextBlock
                    x:Name="Hint"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Visibility="Collapsed" />
            </StackPanel>

            <!-- Chips -->
            <ScrollViewer
                x:Name="ChipScroll"
                Grid.Column="1"
                HorizontalScrollBarVisibility="Auto"
                HorizontalScrollMode="Auto"
                VerticalScrollBarVisibility="Disabled"
                VerticalScrollMode="Disabled">
                <controls:PinnedItemsControl x:Name="Chips" AutomationProperties.Name="Overlaid people">
                    <controls:PinnedItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" Spacing="8" />
                        </ItemsPanelTemplate>
                    </controls:PinnedItemsControl.ItemsPanel>
                    <controls:PinnedItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="local:OverlayChip">
                            <!-- Chip -->
                            <Border
                                Padding="8,2"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                AutomationProperties.AutomationId="{x:Bind ChipId}"
                                AutomationProperties.Name="{x:Bind FullText}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Ellipse Width="8" Height="8" VerticalAlignment="Center" Fill="{x:Bind Dot}" />
                                    <TextBlock VerticalAlignment="Center">
                                        <Run Text="{x:Bind Name}" /><Run Text="{x:Bind UnknownText}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </TextBlock>
                                    <Button
                                        Width="20"
                                        Height="20"
                                        Padding="0"
                                        Style="{StaticResource LeafIconButtonStyle}"
                                        Click="{x:Bind Remove}"
                                        AutomationProperties.AutomationId="{x:Bind RemoveId}"
                                        AutomationProperties.Name="{x:Bind RemoveName}"
                                        ToolTipService.ToolTip="{x:Bind RemoveName}">
                                        <FontIcon Glyph="&#xE711;" FontSize="10" />
                                    </Button>
                                </StackPanel>
                            </Border>
                            <!-- /Chip -->
                        </DataTemplate>
                    </controls:PinnedItemsControl.ItemTemplate>
                </controls:PinnedItemsControl>
            </ScrollViewer>

            <!-- Clear -->
            <Button
                Grid.Column="2"
                VerticalAlignment="Center"
                Content="Clear"
                Click="OnClearClick"
                AutomationProperties.AutomationId="OverlayClear" />
        </Grid>
    </Border>
    <!-- /Overlay Bar -->
</UserControl>
