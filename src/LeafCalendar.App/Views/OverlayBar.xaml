<UserControl
    x:Class="LeafCalendar.App.Views.OverlayBar"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:LeafCalendar.App.Controls"
    xmlns:local="using:LeafCalendar.App.Views"
    Visibility="Collapsed"
    AutomationProperties.AutomationId="OverlayBar"
    AutomationProperties.Name="People overlay">

    <UserControl.Resources>
        <!-- A Person's Chip (their color, name, and a remove button), in the bar or, with no outline, the dropdown -->
        <DataTemplate x:Key="PersonChipTemplate" x:DataType="local:OverlayChip">
            <!-- Chip -->
            <Border
                Padding="8,2"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="{x:Bind Outline}"
                CornerRadius="8"
                AutomationProperties.AutomationId="{x:Bind ChipId}"
                AutomationProperties.Name="{x:Bind FullText}">
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Ellipse Width="8" Height="8" VerticalAlignment="Center" Fill="{x:Bind Dot}" />
                    <TextBlock Grid.Column="1" VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                        <Run Text="{x:Bind Name}" /><Run Text="{x:Bind UnknownText}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </TextBlock>
                    <Button
                        Grid.Column="2"
                        Width="28"
                        Height="28"
                        Padding="0"
                        Style="{StaticResource LeafIconButtonStyle}"
                        Click="{x:Bind Remove}"
                        AutomationProperties.AutomationId="{x:Bind RemoveId}"
                        AutomationProperties.Name="{x:Bind RemoveName}"
                        ToolTipService.ToolTip="{x:Bind RemoveName}">
                        <FontIcon Glyph="&#xE711;" FontSize="12" />
                    </Button>
                </Grid>
            </Border>
            <!-- /Chip -->
        </DataTemplate>
    </UserControl.Resources>

    <!-- Overlay Bar: who is overlaid on the time grid (P, F, E then F): one person's chip, or a dropdown of everyone once
         there are two or more, and Clear. A toast at the bottom of the calendar like the notice: solid, so the grid never
         shows through, and no wider than 640 -->
    <Border
        x:Name="Card"
        x:FieldModifier="internal"
        MaxWidth="640"
        Padding="12,8"
        Background="{ThemeResource SolidBackgroundFillColorTertiaryBrush}"
        BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}"
        BorderThickness="1"
        CornerRadius="8">
        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Label -->
            <StackPanel VerticalAlignment="Center">
                <TextBlock x:Name="Label" Style="{StaticResource CaptionTextBlockStyle}" Text="Busy times" />
                <TextBlock
                    x:Name="Hint"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Visibility="Collapsed" />
            </StackPanel>

            <!-- One Person: Their Chip, With A Remove Button -->
            <controls:PinnedItemsControl
                x:Name="Chips"
                Grid.Column="1"
                ItemTemplate="{StaticResource PersonChipTemplate}"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                AutomationProperties.Name="Overlaid people" />

            <!-- Two Or More People: A Dropdown Listing Them, Each With A Remove Button (the bar never scrolls) -->
            <DropDownButton
                x:Name="PeopleButton"
                Grid.Column="1"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                Visibility="Collapsed"
                AutomationProperties.AutomationId="OverlayPeopleButton">
                <DropDownButton.Flyout>
                    <Flyout x:Name="PeopleFlyout" Placement="Top">
                        <controls:PinnedItemsControl x:Name="PeopleList" ItemTemplate="{StaticResource PersonChipTemplate}" AutomationProperties.Name="Overlaid people">
                            <controls:PinnedItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Spacing="4" />
                                </ItemsPanelTemplate>
                            </controls:PinnedItemsControl.ItemsPanel>
                        </controls:PinnedItemsControl>
                    </Flyout>
                </DropDownButton.Flyout>
                <TextBlock x:Name="PeopleCount" />
            </DropDownButton>

            <!-- Clear -->
            <Button
                x:Name="ClearButton"
                Grid.Column="2"
                VerticalAlignment="Center"
                Content="Clear"
                Click="OnClearClick"
                AutomationProperties.AutomationId="OverlayClear" />
        </Grid>
    </Border>
    <!-- /Overlay Bar -->
</UserControl>
