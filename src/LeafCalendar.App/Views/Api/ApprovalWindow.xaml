<Window
    x:Class="LeafCalendar.App.Views.Api.ApprovalWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Leaf Calendar">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <!-- Esc refuses anywhere in the window; its shortcut tooltip is hidden, or hovering anywhere would show "Esc" -->
    <Grid
        x:Name="RootGrid"
        KeyboardAcceleratorPlacementMode="Hidden"
        AutomationProperties.AutomationId="ApiApprovalRoot">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Key="Escape" Invoked="OnEscapeInvoked" />
        </Grid.KeyboardAccelerators>

        <!-- Title Bar (app icon and name; the window draws only Close) -->
        <TitleBar
            x:Name="AppTitleBar"
            Title="Leaf Calendar"
            IsBackButtonVisible="False"
            IsPaneToggleButtonVisible="False"
            AutomationProperties.AutomationId="ApiApprovalTitleBar">
            <TitleBar.Resources>
                <x:Double x:Key="TitleBarCompactHeight">48</x:Double>
                <x:Double x:Key="TitleBarMinDragRegionWidth">0</x:Double>
            </TitleBar.Resources>
            <TitleBar.IconSource>
                <ImageIconSource>
                    <ImageIconSource.ImageSource>
                        <!-- Decoded at its size on screen (16 DIP at this scale), so it isn't shrunk with jagged edges -->
                        <BitmapImage UriSource="ms-appx:///Assets/AppLogo.png" DecodePixelWidth="16" DecodePixelHeight="16" DecodePixelType="Logical" />
                    </ImageIconSource.ImageSource>
                </ImageIconSource>
            </TitleBar.IconSource>
        </TitleBar>

        <!-- Question (one icon, who asks, what it can do, and its full path). It takes
             focus when the window opens, so Enter and Space never press a button; its name is the headline. No focus rectangle: it isn't something to press -->
        <ContentControl
            x:Name="QuestionArea"
            Grid.Row="1"
            HorizontalContentAlignment="Stretch"
            IsTabStop="True"
            UseSystemFocusVisuals="False"
            AutomationProperties.AutomationId="ApiApprovalQuestion">
            <StackPanel Padding="24,12,24,24" Spacing="12">
                <!-- One Icon: the app's own when it sent one Windows can show, else the program's, else the generic app glyph.
                     The image's automation ID says which is showing (set in code), for UI tests -->
                <Grid HorizontalAlignment="Left" Width="48" Height="48">
                    <FontIcon
                        x:Name="IconGlyph"
                        FontSize="48"
                        Glyph="&#xECAA;"
                        AutomationProperties.AccessibilityView="Raw" />
                    <Image
                        x:Name="IconImage"
                        Width="48"
                        Height="48"
                        Visibility="Collapsed"
                        ImageFailed="OnIconFailed"
                        AutomationProperties.AccessibilityView="Raw" />
                </Grid>
                <TextBlock
                    x:Name="HeadlineText"
                    Style="{StaticResource SubtitleTextBlockStyle}"
                    TextWrapping="Wrap"
                    AutomationProperties.HeadingLevel="Level1"
                    AutomationProperties.LiveSetting="Assertive"
                    AutomationProperties.AutomationId="ApiApprovalHeadline" />
                <TextBlock x:Name="BodyText" TextWrapping="Wrap" AutomationProperties.AutomationId="ApiApprovalBody" />
                <TextBlock
                    x:Name="WarningText"
                    Foreground="{ThemeResource SystemFillColorCautionBrush}"
                    TextWrapping="Wrap"
                    Visibility="Collapsed"
                    AutomationProperties.AutomationId="ApiApprovalWarning" />

                <!-- Path (selectable, so it can be copied) -->
                <TextBlock
                    x:Name="PathText"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    IsTextSelectionEnabled="True"
                    TextWrapping="Wrap"
                    AutomationProperties.AutomationId="ApiApprovalPath" />
            </StackPanel>
        </ContentControl>

        <!-- Answer (side by side; neither is the default: Esc and Close refuse. Allow turns on a moment after the window opens, so a click meant for something else can't approve) -->
        <Grid
            Grid.Row="2"
            Padding="24"
            ColumnSpacing="8"
            Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="0,1,0,0"
            ColumnDefinitions="*,*">
            <Button
                x:Name="AllowButton"
                Style="{StaticResource AccentButtonStyle}"
                HorizontalAlignment="Stretch"
                Content="Allow"
                IsEnabled="False"
                Click="OnAllowClick"
                AutomationProperties.AutomationId="ApiApprovalAllowButton" />
            <Button
                Grid.Column="1"
                HorizontalAlignment="Stretch"
                Content="Don't allow"
                Click="OnDenyClick"
                AutomationProperties.AutomationId="ApiApprovalDenyButton" />
        </Grid>
    </Grid>
</Window>
