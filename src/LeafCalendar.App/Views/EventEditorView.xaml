<UserControl
    x:Class="LeafCalendar.App.Views.EventEditorView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:LeafCalendar.App.ViewModels"
    xmlns:local="using:LeafCalendar.App.Views"
    xmlns:controls="using:LeafCalendar.App.Controls"
    AutomationProperties.Name="Event editor"
    AutomationProperties.AutomationId="EventEditor">

    <!-- Ctrl+Enter saves, Ctrl+Shift+Enter saves without emailing, Esc cancels (see OnPreviewKeyDown) -->
    <Grid RowDefinitions="*,Auto" PreviewKeyDown="OnPreviewKeyDown">

        <!-- Body (scrolls under the pinned footer) -->
        <ScrollViewer x:Name="BodyScroll">
            <StackPanel Spacing="12" Padding="16,8,16,16">
                <TextBlock
                    Style="{StaticResource BodyStrongTextBlockStyle}"
                    Text="{x:Bind Editor.HeaderText, Mode=OneWay}"
                    TextTrimming="CharacterEllipsis"
                    AutomationProperties.AutomationId="EditorHeader" />

                <!-- Event Type (new timed events on a Workspace account's primary calendar) -->
                <ComboBox
                    x:Name="EventTypeBox"
                    HorizontalAlignment="Stretch"
                    SelectedIndex="{x:Bind Editor.EventTypeIndex, Mode=TwoWay}"
                    Visibility="{x:Bind Editor.ShowEventType, Mode=OneWay}"
                    AutomationProperties.Name="Event type"
                    AutomationProperties.AutomationId="EditorEventType">
                    <ComboBoxItem Content="Event" />
                    <ComboBoxItem Content="Focus time" />
                    <ComboBoxItem Content="Out of office" />
                </ComboBox>

                <!-- Title -->
                <TextBox
                    x:Name="TitleBox"
                    FontSize="18"
                    PlaceholderText="Add title"
                    Text="{x:Bind Editor.Title, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    AutomationProperties.Name="Title"
                    AutomationProperties.AutomationId="EditorTitle" />

                <!-- When -->
                <CheckBox Content="All day" IsChecked="{x:Bind Editor.IsAllDay, Mode=TwoWay}" IsEnabled="{x:Bind Editor.IsOrdinaryType, Mode=OneWay}" AutomationProperties.AutomationId="EditorAllDay" />
                <StackPanel Spacing="8">
                    <!-- Starts -->
                    <Grid ColumnSpacing="8" ColumnDefinitions="*,132">
                        <CalendarDatePicker
                            Grid.ColumnSpan="{x:Bind local:EventEditorView.DateSpan(Editor.ShowTimes), Mode=OneWay}"
                            Header="Starts"
                            HorizontalAlignment="Stretch"
                            Date="{x:Bind Editor.StartDate, Mode=TwoWay}"
                            AutomationProperties.AutomationId="EditorStartDate" />
                        <controls:LeafTimePicker
                            Grid.Column="1"
                            MinWidth="0"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Bottom"
                            MinuteIncrement="5"
                            ClockIdentifier="{x:Bind Editor.Clock, Mode=OneWay}"
                            Time="{x:Bind Editor.StartTime, Mode=TwoWay}"
                            Visibility="{x:Bind Editor.ShowTimes, Mode=OneWay}"
                            AutomationProperties.Name="Start time"
                            AutomationProperties.AutomationId="EditorStartTime" />
                    </Grid>

                    <!-- Ends -->
                    <Grid ColumnSpacing="8" ColumnDefinitions="*,132">
                        <CalendarDatePicker
                            Grid.ColumnSpan="{x:Bind local:EventEditorView.DateSpan(Editor.ShowTimes), Mode=OneWay}"
                            Header="Ends"
                            HorizontalAlignment="Stretch"
                            Date="{x:Bind Editor.EndDate, Mode=TwoWay}"
                            AutomationProperties.AutomationId="EditorEndDate" />
                        <controls:LeafTimePicker
                            x:Name="EndTimePicker"
                            Grid.Column="1"
                            MinWidth="0"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Bottom"
                            MinuteIncrement="5"
                            ClockIdentifier="{x:Bind Editor.Clock, Mode=OneWay}"
                            Time="{x:Bind Editor.EndTime, Mode=TwoWay}"
                            Visibility="{x:Bind Editor.ShowTimes, Mode=OneWay}"
                            AutomationProperties.Name="End time"
                            AutomationProperties.AutomationId="EditorEndTime" />
                    </Grid>

                    <!-- Time Zone (the dates and times above are on this zone's clock). A searchable dropdown: typing filters,
                         the arrow lists every common zone, and only a zone from the list is taken -->
                    <AutoSuggestBox
                        x:Name="TimeZoneBox"
                        Header="Time zone"
                        UpdateTextOnSelect="False"
                        Text="{x:Bind Editor.ZoneInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        ItemsSource="{x:Bind Editor.ZoneSuggestions, Mode=OneWay}"
                        Visibility="{x:Bind Editor.ShowTimeZone, Mode=OneWay}"
                        TextChanged="OnZoneTextChanged"
                        QuerySubmitted="OnZoneQuerySubmitted"
                        GotFocus="OnZoneGotFocus"
                        LostFocus="OnZoneLostFocus"
                        PreviewKeyDown="OnZoneKeyDown"
                        AutomationProperties.Name="Time zone"
                        AutomationProperties.AutomationId="EditorTimeZoneBox">
                        <AutoSuggestBox.QueryIcon>
                            <FontIcon Glyph="&#xE70D;" FontSize="12" />
                        </AutoSuggestBox.QueryIcon>
                        <AutoSuggestBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:ZoneSuggestion">
                                <!-- City and offset, then Windows' zone name under it (each fits the 320 panel) -->
                                <StackPanel Padding="0,4">
                                    <TextBlock Text="{x:Bind Label}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="{x:Bind ZoneName}"
                                        TextWrapping="Wrap" />
                                </StackPanel>
                            </DataTemplate>
                        </AutoSuggestBox.ItemTemplate>
                    </AutoSuggestBox>
                    <TextBlock
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        TextWrapping="Wrap"
                        Text="{x:Bind Editor.LocalTimeText, Mode=OneWay}"
                        Visibility="{x:Bind Editor.ShowLocalTime, Mode=OneWay}"
                        AutomationProperties.AutomationId="EditorLocalTimeText" />
                </StackPanel>
                <!-- /When -->

                <!-- Divider -->
                <Border Style="{StaticResource LeafDividerStyle}" AutomationProperties.AutomationId="EditorDivider_Calendar" />

                <!-- Calendar -->
                <controls:PinnedComboBox x:Name="CalendarBox" Header="Calendar" HorizontalAlignment="Stretch" ItemsSource="{x:Bind Editor.Calendars, Mode=OneWay}" SelectedIndex="{x:Bind Editor.CalendarIndex, Mode=TwoWay}" AutomationProperties.AutomationId="EditorCalendar">
                    <controls:PinnedComboBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:CalendarChoice">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Ellipse Width="10" Height="10" VerticalAlignment="Center" Fill="{x:Bind local:EventEditorView.Brush(Color)}" />
                                <StackPanel>
                                    <TextBlock Text="{x:Bind Name}" />
                                    <TextBlock Text="{x:Bind AccountEmail}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Visibility="{x:Bind ShowAccount}" />
                                </StackPanel>
                            </StackPanel>
                        </DataTemplate>
                    </controls:PinnedComboBox.ItemTemplate>
                </controls:PinnedComboBox>

                <!-- Show As And Visibility (the items say what each dropdown is, so there are no labels). Each stretches the
                     full width on its own row: a ComboBox sized by its content measures narrower while its list is open,
                     which moved the pair, and side by side "Show me as busy" doesn't fit the 320 panel -->
                <Grid RowSpacing="8" RowDefinitions="Auto,Auto">
                    <ComboBox
                        x:Name="ShowAsBox"
                        HorizontalAlignment="Stretch"
                        SelectedIndex="{x:Bind Editor.ShowAsIndex, Mode=TwoWay}"
                        IsEnabled="{x:Bind Editor.IsOrdinaryType, Mode=OneWay}"
                        ToolTipService.ToolTip="Show me as"
                        AutomationProperties.Name="Show as"
                        AutomationProperties.AutomationId="EditorShowAs">
                        <ComboBoxItem Content="Show me as busy" />
                        <ComboBoxItem Content="Show me as free" />
                    </ComboBox>
                    <ComboBox
                        x:Name="VisibilityBox"
                        Grid.Row="1"
                        HorizontalAlignment="Stretch"
                        SelectedIndex="{x:Bind Editor.VisibilityIndex, Mode=TwoWay}"
                        ToolTipService.ToolTip="Visibility"
                        AutomationProperties.Name="Visibility"
                        AutomationProperties.AutomationId="EditorVisibility">
                        <ComboBoxItem Content="Default visibility" />
                        <ComboBoxItem Content="Public" />
                        <ComboBoxItem Content="Private" />
                    </ComboBox>
                </Grid>

                <!-- Color (swatches built in code: the calendar's color, then Google's 11 event colors) -->
                <StackPanel Spacing="4">
                    <TextBlock Text="Color" />
                    <VariableSizedWrapGrid x:Name="ColorPanel" Orientation="Horizontal" ItemWidth="30" ItemHeight="30" />
                </StackPanel>

                <!-- Repeat -->
                <ComboBox x:Name="RepeatBox" Header="Repeat" HorizontalAlignment="Stretch" SelectedIndex="{x:Bind Editor.RepeatIndex, Mode=TwoWay}" AutomationProperties.AutomationId="EditorRepeat">
                    <ComboBoxItem Content="Doesn't repeat" />
                    <ComboBoxItem Content="Daily" />
                    <ComboBoxItem Content="Weekly" />
                    <ComboBoxItem Content="Monthly" />
                    <ComboBoxItem Content="Yearly" />
                    <ComboBoxItem Content="Custom rule (kept as is)" Visibility="{x:Bind Editor.HasCustomRule, Mode=OneWay}" />
                </ComboBox>
                <StackPanel Spacing="8" Visibility="{x:Bind Editor.ShowRepeatOptions, Mode=OneWay}">
                    <NumberBox Header="Every" Minimum="1" Maximum="99" SpinButtonPlacementMode="Compact" Value="{x:Bind Editor.RepeatInterval, Mode=TwoWay}" AutomationProperties.AutomationId="EditorRepeatInterval" />
                    <controls:PinnedItemsControl x:Name="WeekdayList" ItemsSource="{x:Bind Editor.Weekdays, Mode=OneWay}" Visibility="{x:Bind Editor.ShowWeekdays, Mode=OneWay}">
                        <controls:PinnedItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="4" />
                            </ItemsPanelTemplate>
                        </controls:PinnedItemsControl.ItemsPanel>
                        <controls:PinnedItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:WeekdayToggle">
                                <ToggleButton MinWidth="34" Padding="4" Content="{x:Bind Label}" IsChecked="{x:Bind IsOn, Mode=TwoWay}" AutomationProperties.AutomationId="{x:Bind AutomationId}" />
                            </DataTemplate>
                        </controls:PinnedItemsControl.ItemTemplate>
                    </controls:PinnedItemsControl>
                    <ComboBox x:Name="EndsBox" Header="Ends" HorizontalAlignment="Stretch" SelectedIndex="{x:Bind Editor.EndsIndex, Mode=TwoWay}" AutomationProperties.AutomationId="EditorEnds">
                        <ComboBoxItem Content="Never" />
                        <ComboBoxItem Content="On a date" />
                        <ComboBoxItem Content="After a number of times" />
                    </ComboBox>
                    <CalendarDatePicker HorizontalAlignment="Stretch" Date="{x:Bind Editor.EndsOn, Mode=TwoWay}" Visibility="{x:Bind Editor.ShowEndsOn, Mode=OneWay}" AutomationProperties.AutomationId="EditorEndsOn" />
                    <NumberBox Minimum="1" Maximum="999" SpinButtonPlacementMode="Compact" Value="{x:Bind Editor.EndsAfter, Mode=TwoWay}" Visibility="{x:Bind Editor.ShowEndsAfter, Mode=OneWay}" AutomationProperties.AutomationId="EditorEndsAfter" />
                </StackPanel>
                <!-- /Repeat -->

                <!-- Divider -->
                <Border Style="{StaticResource LeafDividerStyle}" AutomationProperties.AutomationId="EditorDivider_Guests" />

                <!-- Location -->
                <TextBox Header="Location" Text="{x:Bind Editor.Location, Mode=TwoWay}" Visibility="{x:Bind Editor.ShowLocation, Mode=OneWay}" AutomationProperties.AutomationId="EditorLocation" />

                <!-- Divider (between the location and the video call and guests) -->
                <Border Style="{StaticResource LeafDividerStyle}" Visibility="{x:Bind Editor.ShowGuests, Mode=OneWay}" AutomationProperties.AutomationId="EditorDivider_Call" />

                <!-- Video Call (new events start from the account's Meet by default; Google makes the Meet link on save) -->
                <Grid ColumnSpacing="8" ColumnDefinitions="*,Auto" Visibility="{x:Bind Editor.ShowConference, Mode=OneWay}">
                    <TextBlock VerticalAlignment="Center" Text="{x:Bind Editor.ConferenceText, Mode=OneWay}" TextWrapping="Wrap" AutomationProperties.AutomationId="EditorConference" />
                    <Button x:Name="AddConferenceButton" Grid.Column="1" Content="Add Google Meet" Click="OnAddConferenceClick" Visibility="{x:Bind Editor.CanAddConference, Mode=OneWay}" AutomationProperties.AutomationId="EditorAddConference" />
                    <Button x:Name="RemoveConferenceButton" Grid.Column="1" Content="Remove" Click="OnRemoveConferenceClick" Visibility="{x:Bind Editor.HasConference, Mode=OneWay}" ToolTipService.ToolTip="Remove video call" AutomationProperties.Name="Remove video call" AutomationProperties.AutomationId="EditorRemoveConference" />
                </Grid>

                <!-- Guests -->
                <StackPanel Spacing="8" Visibility="{x:Bind Editor.ShowGuests, Mode=OneWay}">
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <!-- Guest Box (suggests contacts; the box text stays ours on a pick) -->
                        <AutoSuggestBox
                            x:Name="GuestBox"
                            Header="Guests"
                            PlaceholderText="Name or email"
                            UpdateTextOnSelect="False"
                            Text="{x:Bind Editor.GuestInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            ItemsSource="{x:Bind Editor.Suggestions, Mode=OneWay}"
                            TextChanged="OnGuestTextChanged"
                            QuerySubmitted="OnGuestQuerySubmitted"
                            AutomationProperties.AutomationId="EditorGuestInput">
                            <AutoSuggestBox.ItemTemplate>
                                <DataTemplate x:DataType="vm:ContactSuggestion">
                                    <TextBlock Text="{x:Bind Display}" TextTrimming="CharacterEllipsis" />
                                </DataTemplate>
                            </AutoSuggestBox.ItemTemplate>
                        </AutoSuggestBox>
                        <Button Grid.Column="1" VerticalAlignment="Bottom" Content="Add" Click="OnAddGuestClick" AutomationProperties.AutomationId="EditorAddGuest" />
                    </Grid>
                    <HyperlinkButton
                        x:Name="AllowContactsLink"
                        Content="Allow contact suggestions"
                        Click="OnAllowContactsClick"
                        Visibility="{x:Bind Editor.ShowAllowContacts, Mode=OneWay}"
                        AutomationProperties.AutomationId="EditorAllowContacts" />
                    <TextBlock
                        x:Name="ContactsApiOffText"
                        Style="{StaticResource LeafSecondaryTextStyle}"
                        Text="Turn on the People API in Google Cloud Console to get suggestions."
                        Visibility="{x:Bind Editor.ShowContactsApiOff, Mode=OneWay}"
                        AutomationProperties.AutomationId="EditorContactsApiOff" />

                    <!-- Room Box (Workspace accounts: rooms you've booked before) -->
                    <AutoSuggestBox
                        x:Name="RoomBox"
                        PlaceholderText="Add a room"
                        UpdateTextOnSelect="False"
                        Text="{x:Bind Editor.RoomInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        ItemsSource="{x:Bind Editor.RoomSuggestions, Mode=OneWay}"
                        Visibility="{x:Bind Editor.ShowRooms, Mode=OneWay}"
                        TextChanged="OnRoomTextChanged"
                        QuerySubmitted="OnRoomQuerySubmitted"
                        AutomationProperties.Name="Add a room"
                        AutomationProperties.AutomationId="EditorRoomInput">
                        <AutoSuggestBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:RoomSuggestion">
                                <TextBlock Text="{x:Bind Display}" TextTrimming="CharacterEllipsis" />
                            </DataTemplate>
                        </AutoSuggestBox.ItemTemplate>
                    </AutoSuggestBox>
                    <controls:PinnedItemsControl x:Name="GuestList" ItemsSource="{x:Bind Editor.Guests, Mode=OneWay}">
                        <controls:PinnedItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Spacing="4" />
                            </ItemsPanelTemplate>
                        </controls:PinnedItemsControl.ItemsPanel>
                        <controls:PinnedItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:GuestRow">
                                <!-- Guest Chip (name, then the address on its own line, then Optional; remove pinned top right) -->
                                <Border
                                    Padding="8,4,4,4"
                                    CornerRadius="{StaticResource OverlayCornerRadius}"
                                    Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1">
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <FontIcon VerticalAlignment="Center" Glyph="&#xE7BE;" FontSize="16" Visibility="{x:Bind IsRoom}" />
                                                <TextBlock
                                                    VerticalAlignment="Center"
                                                    Text="{x:Bind DisplayName, Mode=OneWay}"
                                                    TextTrimming="CharacterEllipsis"
                                                    AutomationProperties.AutomationId="{x:Bind GuestId}" />
                                            </StackPanel>
                                            <TextBlock
                                                Style="{StaticResource CaptionTextBlockStyle}"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                Text="{x:Bind Detail}"
                                                TextTrimming="CharacterEllipsis"
                                                TextWrapping="NoWrap"
                                                Visibility="{x:Bind ShowDetail}"
                                                AutomationProperties.AutomationId="{x:Bind DetailId}" />
                                            <CheckBox MinWidth="0" Content="Optional" IsChecked="{x:Bind Optional, Mode=TwoWay}" Visibility="{x:Bind ShowOptional}" ToolTipService.ToolTip="Optional guests can decline without affecting the meeting" AutomationProperties.AutomationId="{x:Bind OptionalId}" />
                                        </StackPanel>
                                        <Button
                                            Grid.Column="1"
                                            VerticalAlignment="Top"
                                            Style="{StaticResource LeafIconButtonStyle}"
                                            Command="{x:Bind RemoveCommand}"
                                            ToolTipService.ToolTip="Remove guest"
                                            AutomationProperties.Name="Remove guest"
                                            AutomationProperties.AutomationId="{x:Bind RemoveId}">
                                            <FontIcon Glyph="&#xE711;" FontSize="12" />
                                        </Button>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </controls:PinnedItemsControl.ItemTemplate>
                    </controls:PinnedItemsControl>
                </StackPanel>
                <!-- /Guests -->

                <!-- Divider -->
                <Border Style="{StaticResource LeafDividerStyle}" AutomationProperties.AutomationId="EditorDivider_Reminder" />

                <!-- Reminder -->
                <StackPanel Spacing="8">
                    <TextBlock Text="Reminder" />
                    <CheckBox Content="Use calendar default" IsChecked="{x:Bind Editor.UseDefaultReminders, Mode=TwoWay}" AutomationProperties.AutomationId="EditorDefaultReminders" />
                    <StackPanel Visibility="{x:Bind Editor.ShowReminderChoices, Mode=OneWay}">
                        <controls:PinnedItemsControl x:Name="ReminderList" ItemsSource="{x:Bind Editor.ReminderRows, Mode=OneWay}">
                            <controls:PinnedItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:ReminderRow">
                                    <Grid Margin="0,0,0,4" ColumnSpacing="4" ColumnDefinitions="*,Auto">
                                        <ComboBox
                                            HorizontalAlignment="Stretch"
                                            ItemsSource="{x:Bind Choices}"
                                            SelectedIndex="{x:Bind ChoiceIndex, Mode=TwoWay}"
                                            DropDownOpened="OnReminderDropDownOpened"
                                            DropDownClosed="OnReminderDropDownClosed"
                                            AutomationProperties.Name="{x:Bind AccessibleName, Mode=OneWay}"
                                            AutomationProperties.AutomationId="{x:Bind AutomationId, Mode=OneWay}" />
                                        <Button
                                            Grid.Column="1"
                                            Style="{StaticResource LeafIconButtonStyle}"
                                            Command="{x:Bind RemoveCommand}"
                                            ToolTipService.ToolTip="Remove reminder"
                                            AutomationProperties.Name="Remove reminder"
                                            AutomationProperties.AutomationId="{x:Bind RemoveId, Mode=OneWay}">
                                            <FontIcon Glyph="&#xE711;" FontSize="12" />
                                        </Button>
                                    </Grid>
                                </DataTemplate>
                            </controls:PinnedItemsControl.ItemTemplate>
                        </controls:PinnedItemsControl>
                        <!-- Add Reminder (a plain link: no fill on hover or press, the stock link padding kept) -->
                        <HyperlinkButton Content="Add reminder" Click="OnAddReminderClick" Visibility="{x:Bind Editor.CanAddReminder, Mode=OneWay}" AutomationProperties.AutomationId="EditorAddReminder">
                            <HyperlinkButton.Resources>
                                <SolidColorBrush x:Key="HyperlinkButtonBackgroundPointerOver" Color="Transparent" />
                                <SolidColorBrush x:Key="HyperlinkButtonBackgroundPressed" Color="Transparent" />
                            </HyperlinkButton.Resources>
                        </HyperlinkButton>
                    </StackPanel>
                </StackPanel>
                <!-- /Reminder -->

                <!-- Divider -->
                <Border Style="{StaticResource LeafDividerStyle}" AutomationProperties.AutomationId="EditorDivider_Description" />

                <!-- Description (filled and read back in code: see LoadDescription and CommitDescription) -->
                <StackPanel Spacing="4">
                    <TextBlock Text="Description" />

                    <!-- Description Box (the toolbar is its own row laid over the box, inside its border, with a divider
                         under it; the box's top padding, set in LoadDescription, keeps typed text below the divider) -->
                    <Grid>
                        <RichEditBox
                            x:Name="DescriptionBox"
                            MinHeight="112"
                            TextWrapping="Wrap"
                            DisabledFormattingAccelerators="None"
                            ClipboardCopyFormat="PlainText"
                            AllowDrop="False"
                            AutomationProperties.Name="Description"
                            AutomationProperties.AutomationId="EditorDescription"
                            Paste="OnDescriptionPaste"
                            TextChanged="OnDescriptionTextChanged"
                            SelectionChanged="OnDescriptionSelectionChanged" />

                        <!-- Description Toolbar (hidden when the description is read-only). The toggles are bare glyphs: no
                             fill or border in any state, and an active format shows its glyph in the accent color -->
                        <Grid x:Name="DescriptionToolbar" VerticalAlignment="Top" RowDefinitions="Auto,Auto">
                            <Grid.Resources>
                                <ResourceDictionary>
                                    <ResourceDictionary.ThemeDictionaries>
                                        <ResourceDictionary x:Key="Default">
                                            <SolidColorBrush x:Key="ToggleButtonBackground" Color="Transparent" />
                                            <SolidColorBrush x:Key="ToggleButtonBackgroundPointerOver" Color="Transparent" />
                                            <SolidColorBrush x:Key="ToggleButtonBackgroundPressed" Color="Transparent" />
                                            <SolidColorBrush x:Key="ToggleButtonBackgroundChecked" Color="Transparent" />
                                            <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPointerOver" Color="Transparent" />
                                            <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPressed" Color="Transparent" />
                                            <SolidColorBrush x:Key="ToggleButtonBorderBrush" Color="Transparent" />
                                            <SolidColorBrush x:Key="ToggleButtonBorderBrushPointerOver" Color="Transparent" />
                                            <SolidColorBrush x:Key="ToggleButtonBorderBrushPressed" Color="Transparent" />
                                            <SolidColorBrush x:Key="ToggleButtonBorderBrushChecked" Color="Transparent" />
                                            <SolidColorBrush x:Key="ToggleButtonBorderBrushCheckedPointerOver" Color="Transparent" />
                                            <SolidColorBrush x:Key="ToggleButtonBorderBrushCheckedPressed" Color="Transparent" />
                                            <StaticResource x:Key="ToggleButtonForegroundChecked" ResourceKey="AccentTextFillColorPrimaryBrush" />
                                            <StaticResource x:Key="ToggleButtonForegroundCheckedPointerOver" ResourceKey="AccentTextFillColorSecondaryBrush" />
                                            <StaticResource x:Key="ToggleButtonForegroundCheckedPressed" ResourceKey="AccentTextFillColorTertiaryBrush" />
                                        </ResourceDictionary>
                                        <ResourceDictionary x:Key="HighContrast">
                                            <SolidColorBrush x:Key="ToggleButtonBackground" Color="Transparent" />
                                            <SolidColorBrush x:Key="ToggleButtonBackgroundPointerOver" Color="Transparent" />
                                            <SolidColorBrush x:Key="ToggleButtonBackgroundPressed" Color="Transparent" />
                                            <SolidColorBrush x:Key="ToggleButtonBackgroundChecked" Color="Transparent" />
                                            <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPointerOver" Color="Transparent" />
                                            <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPressed" Color="Transparent" />
                                            <SolidColorBrush x:Key="ToggleButtonBorderBrush" Color="Transparent" />
                                            <SolidColorBrush x:Key="ToggleButtonBorderBrushPointerOver" Color="Transparent" />
                                            <SolidColorBrush x:Key="ToggleButtonBorderBrushPressed" Color="Transparent" />
                                            <SolidColorBrush x:Key="ToggleButtonBorderBrushChecked" Color="Transparent" />
                                            <SolidColorBrush x:Key="ToggleButtonBorderBrushCheckedPointerOver" Color="Transparent" />
                                            <SolidColorBrush x:Key="ToggleButtonBorderBrushCheckedPressed" Color="Transparent" />
                                            <SolidColorBrush x:Key="ToggleButtonForegroundChecked" Color="{ThemeResource SystemColorHighlightColor}" />
                                            <SolidColorBrush x:Key="ToggleButtonForegroundCheckedPointerOver" Color="{ThemeResource SystemColorHighlightColor}" />
                                            <SolidColorBrush x:Key="ToggleButtonForegroundCheckedPressed" Color="{ThemeResource SystemColorHighlightColor}" />
                                        </ResourceDictionary>
                                    </ResourceDictionary.ThemeDictionaries>
                                </ResourceDictionary>
                            </Grid.Resources>

                            <!-- Format Buttons -->
                            <StackPanel Margin="4" Orientation="Horizontal" Spacing="4">
                                <ToggleButton
                                    x:Name="BoldButton"
                                    Width="32"
                                    Height="32"
                                    Padding="0"
                                    AllowFocusOnInteraction="False"
                                    Click="OnBoldClick"
                                    ToolTipService.ToolTip="Bold (Ctrl+B)"
                                    AutomationProperties.Name="Bold"
                                    AutomationProperties.AutomationId="DescriptionBold">
                                    <FontIcon Glyph="&#xE8DD;" FontSize="16" />
                                </ToggleButton>
                                <ToggleButton
                                    x:Name="ItalicButton"
                                    Width="32"
                                    Height="32"
                                    Padding="0"
                                    AllowFocusOnInteraction="False"
                                    Click="OnItalicClick"
                                    ToolTipService.ToolTip="Italic (Ctrl+I)"
                                    AutomationProperties.Name="Italic"
                                    AutomationProperties.AutomationId="DescriptionItalic">
                                    <FontIcon Glyph="&#xE8DB;" FontSize="16" />
                                </ToggleButton>
                                <ToggleButton
                                    x:Name="UnderlineButton"
                                    Width="32"
                                    Height="32"
                                    Padding="0"
                                    AllowFocusOnInteraction="False"
                                    Click="OnUnderlineClick"
                                    ToolTipService.ToolTip="Underline (Ctrl+U)"
                                    AutomationProperties.Name="Underline"
                                    AutomationProperties.AutomationId="DescriptionUnderline">
                                    <FontIcon Glyph="&#xE8DC;" FontSize="16" />
                                </ToggleButton>
                                <ToggleButton
                                    x:Name="BulletsButton"
                                    Width="32"
                                    Height="32"
                                    Padding="0"
                                    AllowFocusOnInteraction="False"
                                    Click="OnBulletsClick"
                                    ToolTipService.ToolTip="Bulleted list"
                                    AutomationProperties.Name="Bulleted list"
                                    AutomationProperties.AutomationId="DescriptionBullets">
                                    <FontIcon Glyph="&#xE8FD;" FontSize="16" />
                                </ToggleButton>
                                <ToggleButton
                                    x:Name="NumbersButton"
                                    Width="32"
                                    Height="32"
                                    Padding="0"
                                    AllowFocusOnInteraction="False"
                                    Click="OnNumbersClick"
                                    ToolTipService.ToolTip="Numbered list"
                                    AutomationProperties.Name="Numbered list"
                                    AutomationProperties.AutomationId="DescriptionNumbers">
                                    <!-- Segoe Fluent Icons has no numbered list glyph: 1, 2, 3 beside three lines on the 16 DIP grid, 1 px strokes -->
                                    <PathIcon
                                        Width="16"
                                        Height="16"
                                        Data="M2,1 H3 V5 H2 Z M1,6 H4 V7 H1 Z M3,7 H4 V8 H3 Z M1,7.5 H4 V8.5 H1 Z M1,8.5 H2 V10 H1 Z M1,9 H4 V10 H1 Z M1,11 H4 V12 H1 Z M3,12 H4 V15 H3 Z M1.5,12.5 H4 V13.5 H1.5 Z M1,14 H4 V15 H1 Z M6,2.5 H15 V3.5 H6 Z M6,7.5 H15 V8.5 H6 Z M6,12.5 H15 V13.5 H6 Z" />
                                </ToggleButton>
                            </StackPanel>

                            <!-- Divider (1 px, inside the box's border, between the toolbar and the text) -->
                            <Border
                                Grid.Row="1"
                                Height="1"
                                Margin="1,0"
                                Background="{ThemeResource DividerStrokeColorDefaultBrush}"
                                AutomationProperties.AutomationId="DescriptionToolbarDivider" />
                        </Grid>
                        <!-- /Description Toolbar -->
                    </Grid>
                    <!-- /Description Box -->
                </StackPanel>
                <TextBlock Text="This description is too long to edit in Leaf." Visibility="{x:Bind Editor.DescriptionTooLong}" Style="{StaticResource LeafSecondaryTextStyle}" AutomationProperties.AutomationId="EditorDescriptionTooLong" />
                <!-- /Description -->

                <TextBlock Text="{x:Bind Editor.Error, Mode=OneWay}" Visibility="{x:Bind Editor.HasError, Mode=OneWay}" Foreground="{ThemeResource SystemFillColorCriticalBrush}" TextWrapping="Wrap" AutomationProperties.AutomationId="EditorError" />
            </StackPanel>
        </ScrollViewer>
        <!-- /Body -->

        <!-- Footer (pinned; wraps so every button stays whole in the 320 panel) -->
        <Border
            Grid.Row="1"
            Padding="16,12"
            BorderThickness="0,1,0,0"
            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
            AutomationProperties.AutomationId="EditorFooter">
            <Grid ColumnSpacing="8" RowSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Button
                    Style="{StaticResource AccentButtonStyle}"
                    HorizontalAlignment="Stretch"
                    Content="Save"
                    Click="OnSaveClick"
                    ToolTipService.ToolTip="Save and email guests (Ctrl+Enter)"
                    AutomationProperties.AutomationId="EditorSaveButton" />
                <Button
                    Grid.Column="1"
                    HorizontalAlignment="Stretch"
                    Content="Cancel"
                    Click="OnCancelClick"
                    ToolTipService.ToolTip="Esc"
                    AutomationProperties.AutomationId="EditorCancelButton" />
                <Button
                    Grid.Row="1"
                    Grid.ColumnSpan="2"
                    HorizontalAlignment="Stretch"
                    Content="Save without emailing"
                    Click="OnSaveQuietClick"
                    Visibility="{x:Bind Editor.HasGuests, Mode=OneWay}"
                    ToolTipService.ToolTip="Ctrl+Shift+Enter"
                    AutomationProperties.AutomationId="EditorSaveQuietButton" />
            </Grid>
        </Border>
        <!-- /Footer -->
    </Grid>
</UserControl>
