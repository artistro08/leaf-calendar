<UserControl
    x:Class="LeafCalendar.App.Views.DetailsPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:LeafCalendar.App.Controls"
    xmlns:vm="using:LeafCalendar.App.ViewModels"
    xmlns:local="using:LeafCalendar.App.Views"
    AutomationProperties.Name="Details"
    AutomationProperties.AutomationId="DetailsPanel">

    <!-- Top padding clears the title bar row this panel runs under; the details scroll as one, the editor has its own
         scroll and a pinned footer -->
    <Grid Padding="0,48,0,0">
        <!-- Reply Badge Tones (the theme's status brushes, resolved for Leaf's own theme, not Windows'; set from code by the reply) -->
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="ResponseTones">
                <VisualState x:Name="NeutralTone">
                    <VisualState.Setters>
                        <Setter Target="ResponseLabel.Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                        <Setter Target="ResponseGlyph.Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                        <Setter Target="ResponseBadge.Background" Value="{ThemeResource SystemFillColorNeutralBackgroundBrush}" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="PositiveTone">
                    <VisualState.Setters>
                        <Setter Target="ResponseLabel.Foreground" Value="{ThemeResource SystemFillColorSuccessBrush}" />
                        <Setter Target="ResponseGlyph.Foreground" Value="{ThemeResource SystemFillColorSuccessBrush}" />
                        <Setter Target="ResponseBadge.Background" Value="{ThemeResource SystemFillColorSuccessBackgroundBrush}" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="CautionTone">
                    <VisualState.Setters>
                        <Setter Target="ResponseLabel.Foreground" Value="{ThemeResource SystemFillColorCautionBrush}" />
                        <Setter Target="ResponseGlyph.Foreground" Value="{ThemeResource SystemFillColorCautionBrush}" />
                        <Setter Target="ResponseBadge.Background" Value="{ThemeResource SystemFillColorCautionBackgroundBrush}" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="CriticalTone">
                    <VisualState.Setters>
                        <Setter Target="ResponseLabel.Foreground" Value="{ThemeResource SystemFillColorCriticalBrush}" />
                        <Setter Target="ResponseGlyph.Foreground" Value="{ThemeResource SystemFillColorCriticalBrush}" />
                        <Setter Target="ResponseBadge.Background" Value="{ThemeResource SystemFillColorCriticalBackgroundBrush}" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
        <!-- /Reply Badge Tones -->

        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <!-- Headings: each view's first heading is centered on the 28 DIP row right under the title bar, the row the
             sidebar's month title sits in, whatever its size ("Upcoming" centered in the row; a 20 DIP title fills it) -->
        <ScrollViewer x:Name="ContentScroll" AutomationProperties.AutomationId="DetailsScroll">
            <Grid Margin="16,0,16,16">

                <!-- Upcoming -->
                <StackPanel x:Name="UpcomingView" Spacing="8">
                    <!-- Header (hidden with "Done for today", which says it all; one calendar's list keeps it for Show all,
                         which overhangs the 28 DIP row by 2 above and below) -->
                    <Grid x:Name="UpcomingHeaderRow" MinHeight="28" ColumnSpacing="8" ColumnDefinitions="*,Auto">
                        <TextBlock
                            x:Name="UpcomingHeader"
                            VerticalAlignment="Center"
                            Style="{StaticResource BodyStrongTextBlockStyle}"
                            Text="Upcoming"
                            TextTrimming="CharacterEllipsis"
                            AutomationProperties.AutomationId="UpcomingHeader" />
                        <HyperlinkButton
                            x:Name="UpcomingShowAll"
                            Grid.Column="1"
                            Margin="0,-2"
                            VerticalAlignment="Center"
                            Content="Show all calendars"
                            Click="OnUpcomingShowAllClick"
                            Visibility="Collapsed"
                            AutomationProperties.AutomationId="UpcomingShowAll" />
                    </Grid>
                    <controls:PinnedItemsControl x:Name="UpcomingList" AutomationProperties.Name="Upcoming events" AutomationProperties.AutomationId="UpcomingList">
                        <controls:PinnedItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:UpcomingItem">
                                <!-- Row: opens the event (spans the full width with the tray's hover fill; Join sits inside it,
                                     so the row keeps its highlight behind Join while the pointer is on Join too). The row
                                     reaches 8 past the content edges, so its color bar lines up under the heading and Join ends
                                     on the panel's 16 DIP inset, while the hover fill still has room around them -->
                                <Button
                                    Margin="-8,0"
                                    Padding="8,4"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Stretch"
                                    Style="{StaticResource SubtleButtonStyle}"
                                    Click="{x:Bind Open}"
                                    AutomationProperties.Name="{x:Bind Title}">
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Rectangle Width="3" RadiusX="1.5" RadiusY="1.5" Fill="{x:Bind local:DetailsPanel.Brush(Color)}" />
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{x:Bind Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="NoWrap">
                                                <Run Text="{x:Bind When}" /><Run Text=" · " /><Run Text="{x:Bind Relative}" />
                                            </TextBlock>
                                        </StackPanel>

                                        <!-- Join (its own click; the row's doesn't run) -->
                                        <Button
                                            Grid.Column="2"
                                            VerticalAlignment="Center"
                                            Click="{x:Bind Join}"
                                            Visibility="{x:Bind local:DetailsPanel.Visible(CanJoin)}"
                                            AutomationProperties.Name="Join"
                                            AutomationProperties.AutomationId="{x:Bind JoinId}">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <controls:MeetingLogo Provider="{x:Bind Provider}" />
                                                <TextBlock Text="Join" />
                                            </StackPanel>
                                        </Button>
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </controls:PinnedItemsControl.ItemTemplate>
                    </controls:PinnedItemsControl>
                </StackPanel>
                <!-- /Upcoming -->

                <!-- Event Details (event content is plain text; only allowlisted links are clickable) -->
                <StackPanel x:Name="DetailsView" Spacing="16" Visibility="Collapsed">
                    <TextBlock x:Name="TitleText" Style="{StaticResource SubtitleTextBlockStyle}" TextWrapping="Wrap" IsTextSelectionEnabled="True" AutomationProperties.AutomationId="DetailsTitle" />
                    <TextBlock x:Name="WhenText" TextWrapping="Wrap" AutomationProperties.AutomationId="DetailsWhen" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Ellipse x:Name="CalendarDot" Width="10" Height="10" VerticalAlignment="Center" />
                        <TextBlock x:Name="CalendarText" AutomationProperties.AutomationId="DetailsCalendar" />
                    </StackPanel>
                    <TextBlock x:Name="StatusText" Foreground="{ThemeResource TextFillColorSecondaryBrush}" AutomationProperties.AutomationId="DetailsStatus" />

                    <!-- Divider -->
                    <Border x:Name="DividerJoin" Style="{StaticResource LeafDividerStyle}" AutomationProperties.AutomationId="DetailsDivider_Join" />

                    <!-- Join (the whole width; the label names the service, the arrow opens the menu. Two accent buttons that
                         read as one split button. Edit and Delete are icons in the title bar row, see MainWindow) -->
                    <Grid x:Name="JoinGroup" ColumnSpacing="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Button
                            x:Name="JoinButton"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch"
                            Style="{StaticResource AccentButtonStyle}"
                            CornerRadius="4,0,0,4"
                            Click="OnJoinClick"
                            AutomationProperties.Name="Join meeting"
                            AutomationProperties.AutomationId="DetailsJoinButton">
                            <!-- The service's logo and name -->
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <controls:MeetingLogo x:Name="JoinLogo" />
                                <TextBlock x:Name="JoinText" Text="Join meeting" />
                            </StackPanel>
                        </Button>
                        <Button
                            x:Name="JoinMenuButton"
                            Grid.Column="1"
                            Width="32"
                            VerticalAlignment="Stretch"
                            Padding="0"
                            Style="{StaticResource AccentButtonStyle}"
                            CornerRadius="0,4,4,0"
                            Click="OnJoinMenuClick"
                            ToolTipService.ToolTip="More join options"
                            AutomationProperties.Name="More join options"
                            AutomationProperties.AutomationId="DetailsJoinMenuButton">
                            <FontIcon Glyph="&#xE70D;" FontSize="12" />
                        </Button>

                        <!-- Menu (opened by the arrow button, right-aligned under the group) -->
                        <Grid.Resources>
                            <MenuFlyout x:Name="JoinMenu" Closed="OnJoinMenuClosed">
                                <MenuFlyoutItem Text="Copy link" Click="OnCopyMeetingLinkClick" AutomationProperties.AutomationId="CopyMeetingLinkItem">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE8C8;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                            </MenuFlyout>
                        </Grid.Resources>
                    </Grid>
                    <!-- /Join -->

                    <!-- Location -->
                    <StackPanel x:Name="LocationRow" Spacing="12">
                        <TextBlock x:Name="LocationText" TextWrapping="Wrap" IsTextSelectionEnabled="True" AutomationProperties.AutomationId="DetailsLocation" />
                        <Button x:Name="MapsLink" HorizontalAlignment="Stretch" Content="Open in Google Maps" Click="OnMapsClick" AutomationProperties.AutomationId="DetailsMapsLink" />
                    </StackPanel>
                    <TextBlock x:Name="ConferenceText" TextWrapping="Wrap" IsTextSelectionEnabled="True" AutomationProperties.AutomationId="DetailsConference" />

                    <!-- Divider -->
                    <Border x:Name="DividerPeople" Style="{StaticResource LeafDividerStyle}" AutomationProperties.AutomationId="DetailsDivider_People" />

                    <!-- Your Reply (one full-width dropdown: "Your response" on the left, the reply on the right as a colored
                         badge with its icon; the menu sets it) -->
                    <StackPanel x:Name="RsvpRow" Spacing="8">
                        <DropDownButton
                            x:Name="ResponseButton"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Stretch"
                            AutomationProperties.AutomationId="DetailsResponse">
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock VerticalAlignment="Center" Text="Your response" TextTrimming="CharacterEllipsis" />
                                <!-- Badge -->
                                <Border
                                    x:Name="ResponseBadge"
                                    Grid.Column="1"
                                    Padding="8,2"
                                    VerticalAlignment="Center"
                                    CornerRadius="4">
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <FontIcon x:Name="ResponseGlyph" FontSize="12" VerticalAlignment="Center" AutomationProperties.AccessibilityView="Raw" />
                                        <TextBlock x:Name="ResponseLabel" VerticalAlignment="Center" Style="{StaticResource CaptionTextBlockStyle}" FontWeight="SemiBold" AutomationProperties.AutomationId="DetailsResponseLabel" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                            <DropDownButton.Flyout>
                                <MenuFlyout Placement="BottomEdgeAlignedRight">
                                    <MenuFlyoutItem x:Name="RsvpYes" Text="Going" Click="OnRsvpYesClick" AutomationProperties.AutomationId="DetailsRsvpYes">
                                        <MenuFlyoutItem.Icon>
                                            <FontIcon Glyph="&#xE73E;" />
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutItem x:Name="RsvpMaybe" Text="Maybe" Click="OnRsvpMaybeClick" AutomationProperties.AutomationId="DetailsRsvpMaybe">
                                        <MenuFlyoutItem.Icon>
                                            <FontIcon Glyph="&#xE897;" />
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutItem x:Name="RsvpNo" Text="Not going" Click="OnRsvpNoClick" AutomationProperties.AutomationId="DetailsRsvpNo">
                                        <MenuFlyoutItem.Icon>
                                            <FontIcon Glyph="&#xE711;" />
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                </MenuFlyout>
                            </DropDownButton.Flyout>
                        </DropDownButton>
                        <TextBox x:Name="RsvpNote" PlaceholderText="Add a note (optional)" AutomationProperties.Name="Reply note" AutomationProperties.AutomationId="DetailsRsvpNote" />
                        <CheckBox x:Name="RsvpEmail" Content="Email the organizer" IsChecked="True" AutomationProperties.AutomationId="DetailsRsvpEmail" />
                    </StackPanel>
                    <!-- /Your Reply -->

                    <!-- Guests -->
                    <StackPanel x:Name="GuestsRow" Spacing="4">
                        <Grid>
                            <TextBlock x:Name="GuestsText" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <HyperlinkButton x:Name="EmailGuestsLink" HorizontalAlignment="Right" Padding="0" Content="Email guests" Click="OnEmailGuestsClick" AutomationProperties.AutomationId="DetailsEmailGuests" />
                        </Grid>
                        <controls:PinnedItemsControl x:Name="GuestList" AutomationProperties.Name="Guests" AutomationProperties.AutomationId="DetailsGuestList">
                            <controls:PinnedItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:GuestItem">
                                    <StackPanel Padding="0,2">
                                        <TextBlock Text="{x:Bind Primary}" IsTextSelectionEnabled="True" TextTrimming="CharacterEllipsis" />
                                        <TextBlock
                                            Text="{x:Bind Address}"
                                            Style="{StaticResource CaptionTextBlockStyle}"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            IsTextSelectionEnabled="True"
                                            TextTrimming="CharacterEllipsis"
                                            TextWrapping="NoWrap"
                                            Visibility="{x:Bind ShowAddress}" />
                                        <TextBlock Text="{x:Bind Detail}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                    </StackPanel>
                                </DataTemplate>
                            </controls:PinnedItemsControl.ItemTemplate>
                        </controls:PinnedItemsControl>
                    </StackPanel>
                    <!-- /Guests -->

                    <!-- Divider -->
                    <Border x:Name="DividerDescription" Style="{StaticResource LeafDividerStyle}" AutomationProperties.AutomationId="DetailsDivider_Description" />

                    <RichTextBlock x:Name="DescriptionBlock" TextWrapping="Wrap" IsTextSelectionEnabled="True" AutomationProperties.AutomationId="DetailsDescription" />

                    <!-- Shortcuts (what you can press for this event, each key on its own cap; filled in code) -->
                    <Border Style="{StaticResource LeafDividerStyle}" AutomationProperties.AutomationId="DetailsDivider_Shortcuts" />
                    <StackPanel x:Name="ShortcutHints" Spacing="4" AutomationProperties.Name="Shortcuts" AutomationProperties.AutomationId="DetailsShortcuts" />
                </StackPanel>
                <!-- /Event Details -->

                <!-- Several Selected -->
                <StackPanel x:Name="SelectionView" Spacing="12" Visibility="Collapsed">
                    <TextBlock x:Name="SelectionSummary" Style="{StaticResource SubtitleTextBlockStyle}" AutomationProperties.AutomationId="SelectionSummary" />

                    <!-- Which Ones (in time order, each title over its day and time, by its color bar; the panel scrolls when there are many) -->
                    <controls:PinnedItemsControl x:Name="SelectionList" AutomationProperties.Name="Selected events" AutomationProperties.AutomationId="SelectionList">
                        <controls:PinnedItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:SelectedRow">
                                <Grid Padding="0,4" ColumnSpacing="8" ColumnDefinitions="Auto,*">
                                    <Rectangle Width="3" RadiusX="1.5" RadiusY="1.5" Fill="{x:Bind local:DetailsPanel.Brush(Color)}" />
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{x:Bind Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{x:Bind When}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </controls:PinnedItemsControl.ItemTemplate>
                    </controls:PinnedItemsControl>

                    <TextBlock Text="Drag one to move them all. Right-click for color, copy, and delete." TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <Button Content="Delete" Click="OnDeleteClick" AutomationProperties.AutomationId="SelectionDeleteButton" />
                </StackPanel>
                <!-- /Several Selected -->
            </Grid>
        </ScrollViewer>

        <!-- Done For Today (nothing selected and nothing coming up: centered in the panel, faded, an icon over the words) -->
        <StackPanel
            x:Name="UpcomingEmpty"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Spacing="8"
            IsHitTestVisible="False"
            Visibility="Collapsed"
            AutomationProperties.AutomationId="UpcomingEmpty">
            <FontIcon
                HorizontalAlignment="Center"
                FontSize="32"
                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                Glyph="&#xE930;"
                AutomationProperties.AccessibilityView="Raw" />
            <TextBlock
                x:Name="UpcomingEmptyTitle"
                HorizontalAlignment="Center"
                Style="{StaticResource BodyStrongTextBlockStyle}"
                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                Text="Done for today"
                AutomationProperties.AutomationId="UpcomingEmptyTitle" />
            <TextBlock
                x:Name="UpcomingEmptyDetail"
                HorizontalAlignment="Center"
                Style="{StaticResource CaptionTextBlockStyle}"
                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                TextAlignment="Center"
                TextWrapping="Wrap"
                AutomationProperties.AutomationId="UpcomingEmptyDetail" />
        </StackPanel>

        <!-- Editor -->
        <!-- Loaded the first time an editor opens -->
        <local:EventEditorView x:Name="EditorView" x:FieldModifier="internal" x:Load="False" />
    </Grid>
</UserControl>
