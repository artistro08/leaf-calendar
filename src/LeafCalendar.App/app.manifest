<?xml version="1.0" encoding="utf-8"?>
<!-- Per-monitor (v2) DPI awareness: without it Windows treats Leaf as DPI-unaware, draws it at 96 DPI,
     and stretches the bitmap to the monitor's scale (blurry text, pointer positions off by the scale factor) -->
<assembly manifestVersion="1.0" xmlns="urn:schemas-microsoft-com:asm.v1">
    <assemblyIdentity version="1.0.0.0" name="LeafCalendar.app" />
    <application xmlns="urn:schemas-microsoft-com:asm.v3">
        <windowsSettings>
            <dpiAware xmlns="http://schemas.microsoft.com/SMI/2005/WindowsSettings">true/PM</dpiAware>
            <dpiAwareness xmlns="http://schemas.microsoft.com/SMI/2016/WindowsSettings">PerMonitorV2, PerMonitor</dpiAwareness>
        </windowsSettings>
    </application>
</assembly>
